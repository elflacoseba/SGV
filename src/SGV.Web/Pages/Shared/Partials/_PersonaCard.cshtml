@* Partial unificada de la card de Persona. Reemplaza las 4
   implementaciones inline (Usuarios/Details, Usuarios/_Form,
   Ocupaciones/Details, Ocupaciones/_Form) que existían antes del
   change `reusable-persona-card` (issue #219).

   Slice 1 / PR 1 introdujo el partial + helper.
   Slice 2 / PR 2 migra Usuarios (Details + _Form).
   Slice 3 / PR 3 migrará Ocupaciones.

   Modos:
     - readonly (default): muestra datos, sin Quitar/Cambiar,
       sin empty state.
     - editable: agrega Quitar, Buscar (abre ModalId), empty
       state con botón Buscar Persona, y el hidden
       `data-usuario-persona-display-input` que el JS
       `usuario-persona-buscador.js` lee/escribe.

   Ramas de render:
     1. readonly + DTO poblado           → card enriquecida con link
     2. readonly + DTO null + Fallback   → fallback readonly con link (o plano)
     3. readonly + DTO null + sin Fallback → no renderiza nada
     4. editable + DTO poblado           → card enriquecida con Quitar/Cambiar + empty oculto
     5. editable + DTO null + Fallback   → card fallback editable con Quitar/Cambiar
     6. editable + DTO null + sin Fallback → empty state con Buscar Persona

   Contrato ViewData (todos opcionales salvo PersonaIdInputName si
   Mode=editable en los consumidores que bindean a un form):
     Mode              : "readonly" | "editable"           (default "readonly")
     ShowStatusBadge   : bool                              (default true)
     ShowQuitarCambiar : bool                              (default: true cuando editable)
     PersonaDetailUrl  : string?                           (readonly only)
     FallbackDisplay   : string?                           (readonly + editable fallback)
     FallbackUrl       : string?                           (readonly fallback only)
     ModalId           : string                            (default "usuario-persona-buscador-modal")
     PersonaIdInputName: string                            (default "Input.PersonaId")
     DisplayContainerId: string                            (default "usuario-persona-display")

   El helper PersonaFormatHelper.FormatDocumento centraliza la
   composición del documento ("TipoDocumentoCodigo NumeroDocumento",
   separador espacio — ver PERFMT-01/02). *@
@using SGV.Contracts.Personas.Consultas.Dtos
@using SGV.Web.Helpers
@model PersonaDto?
@{
    var rawMode = ViewData["Mode"] as string;
    var mode = string.IsNullOrWhiteSpace(rawMode) ? "readonly" : rawMode.Trim().ToLowerInvariant();
    var isEditable = string.Equals(mode, "editable", StringComparison.Ordinal);
    // Defaults: ShowStatusBadge=true, ShowQuitarCambiar=true (en editable).
    // Pasar `false` desde el consumer los suprime. Pasar otro valor
    // (null/missing) cae al default.
    var showStatusBadge = ViewData["ShowStatusBadge"] is not false;
    var showQuitarCambiar = isEditable && ViewData["ShowQuitarCambiar"] is not false;
    var personaDetailUrl = ViewData["PersonaDetailUrl"] as string;
    var fallbackDisplay = ViewData["FallbackDisplay"] as string;
    var fallbackUrl = ViewData["FallbackUrl"] as string;
    var modalId = ViewData["ModalId"] as string ?? "usuario-persona-buscador-modal";
    var displayContainerId = ViewData["DisplayContainerId"] as string ?? "usuario-persona-display";
    var hasPersona = Model is not null;
    var documento = PersonaFormatHelper.FormatDocumento(Model);

    // Caso 5 (editable + DTO null + FallbackDisplay): la card fallback
    // cubre la presentación de "persona seleccionada pero sin DTO
    // enriquecido" (típico de Edit cuando el API devuelve 404). El
    // empty state se emite pero queda hidden — el JS lo usa cuando el
    // usuario presiona Quitar.
    // Caso 6 (editable + DTO null + sin FallbackDisplay): empty state
    // puro, sin card, sólo "Buscar Persona".
    var isEditableFallback = isEditable && !hasPersona && !string.IsNullOrWhiteSpace(fallbackDisplay);

    // Caso 3 (readonly + sin persona + sin fallback): la partial no
    // renderiza nada. Mantiene la semántica de "no error visible" de
    // PER-CARD-02 y evita markup vacío. En editable siempre se emite
    // el empty state (con hidden=true cuando hay persona/fallback)
    // porque el JS lo lee vía `display.parentElement.querySelector`.
    if (!hasPersona && string.IsNullOrWhiteSpace(fallbackDisplay) && !isEditable)
    {
        return;
    }

    var legajoEnCard = hasPersona && !string.IsNullOrWhiteSpace(Model!.Legajo);

    // Valor del hidden que el JS sincroniza con PersonaDisplay del
    // PageModel. Enriquecido cuando hay DTO, fallback cuando no.
    var displayInputValue = hasPersona
        ? $"{Model.Apellidos}, {Model.Nombres} ({documento})"
        : fallbackDisplay!;
}

@* ────────────────────────────────────────────────────────────
   Rama principal: render de la card según modo + disponibilidad.
   ──────────────────────────────────────────────────────────── *@

@if (hasPersona)
{
    @* Casos 1 y 4: card enriquecida (readonly / editable). *@
    var persona = Model!;
    <div id="@displayContainerId" data-usuario-persona-display>
        <div class="card border mb-0" data-usuario-persona-card>
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h6 class="card-title mb-1" data-usuario-persona-display-text>
                            @if (!string.IsNullOrWhiteSpace(personaDetailUrl))
                            {
                                <a href="@personaDetailUrl">@persona.Apellidos, @persona.Nombres</a>
                            }
                            else
                            {
                                <text>@persona.Apellidos, @persona.Nombres</text>
                            }
                        </h6>
                        @if (isEditable && legajoEnCard)
                        {
                            <span class="text-muted small">Legajo: @persona.Legajo</span>
                        }
                    </div>
                    @if (showQuitarCambiar)
                    {
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-usuario-persona-quitar>
                                Quitar
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-usuario-persona-buscar data-bs-toggle="modal"
                                    data-bs-target="#@modalId">
                                Cambiar
                            </button>
                        </div>
                    }
                </div>
                <dl class="row mb-0">
                    @if (!isEditable && legajoEnCard)
                    {
                        <dt class="col-sm-3 text-muted">Legajo</dt>
                        <dd class="col-sm-9">@persona.Legajo</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(documento))
                    {
                        <dt class="col-sm-3 text-muted">Documento</dt>
                        <dd class="col-sm-9">@documento</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(persona.Email))
                    {
                        <dt class="col-sm-3 text-muted">Email</dt>
                        <dd class="col-sm-9">
                            <a href="mailto:@persona.Email">@persona.Email</a>
                        </dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(persona.Telefono))
                    {
                        <dt class="col-sm-3 text-muted">Teléfono</dt>
                        <dd class="col-sm-9">@persona.Telefono</dd>
                    }
                    @if (showStatusBadge)
                    {
                        <dt class="col-sm-3 text-muted">Estado</dt>
                        <dd class="col-sm-9">
                            @if (persona.IsActive)
                            {
                                <span class="badge badge-soft-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-secondary">Inactiva</span>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>
}
else if (isEditableFallback)
{
    @* Caso 5: editable + DTO null + FallbackDisplay. La card lleva
       PersonaDisplay + Quitar/Cambiar. Sin Legajo/Documento/Email
       (no hay DTO). El empty state se emite abajo con hidden=true
       (caso cubierto por el bloque editable general). *@
    <div id="@displayContainerId" data-usuario-persona-display>
        <div class="card border mb-0" data-usuario-persona-card>
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-2">
                <span data-usuario-persona-display-text>@fallbackDisplay</span>
                @if (showQuitarCambiar)
                {
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-usuario-persona-quitar>
                            Quitar
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-usuario-persona-buscar data-bs-toggle="modal"
                                data-bs-target="#@modalId">
                            Cambiar
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}
else if (isEditable)
{
    @* Caso 6: editable + DTO null + sin FallbackDisplay. La card NO
       se renderiza — el empty state abajo (visible) cubre la
       presentación con Buscar Persona. El contenedor display se
       emite igual para que el JS pueda resolverlo vía
       `displayContainerId`, pero queda vacío hasta que el modal
       escriba la persona seleccionada. *@
    <div id="@displayContainerId" data-usuario-persona-display></div>
}
else
{
    @* Caso 2: readonly + DTO null + FallbackDisplay. Usado por
       Usuarios/Details y Ocupaciones/Details cuando el fetch de la
       persona falla — preserva el texto `PersonaNombre`/`PersonaDisplay`
       y, si llega FallbackUrl, lo envuelve en <a>. NO emite botones
       mutables (es readonly). *@
    <div id="@displayContainerId" data-usuario-persona-display>
        <div class="card-body py-2">
            @if (!string.IsNullOrWhiteSpace(fallbackUrl))
            {
                <a href="@fallbackUrl">@fallbackDisplay</a>
            }
            else
            {
                @fallbackDisplay
            }
        </div>
    </div>
}

@* ────────────────────────────────────────────────────────────
   Empty alternative: en modo editable SIEMPRE se emite (hidden
   cuando hay persona o fallback, visible cuando no hay nada).
   El JS lo lee vía `display.parentElement.querySelector(...)` y
   gestiona visibilidad según el botón Quitar pulse.
   ──────────────────────────────────────────────────────────── *@

@if (isEditable)
{
    <div data-usuario-persona-empty hidden="@(hasPersona || isEditableFallback ? "hidden" : null)">
        <button type="button" class="btn btn-outline-primary"
                data-usuario-persona-buscar data-bs-toggle="modal"
                data-bs-target="#@modalId">
            <i class="ti ti-search me-1"></i>Buscar Persona
        </button>
    </div>
}

@* ────────────────────────────────────────────────────────────
   Hidden editable: el JS lee este hidden via
   `display.parentElement.querySelector('[data-usuario-persona-display-input]')`
   y escribe el texto de la persona seleccionada tras elegir en
   el modal. Sólo se emite cuando la presentación visible es
   Quitar/Cambiar (casos 4 y 5); en empty state puro (caso 6) no
   hay nada que sincronizar.
   ──────────────────────────────────────────────────────────── *@

@if (isEditable && (hasPersona || isEditableFallback))
{
    <input type="hidden" name="PersonaDisplay"
           value="@displayInputValue"
           data-usuario-persona-display-input />
}