@{
    var currentPath = Context.Request.Path;
    var homeActive = currentPath == "/" ? "active" : string.Empty;
    var unidadesOrganizativasActive = currentPath.StartsWithSegments("/organizacion/unidades-organizativas") ? "active" : string.Empty;
    var cargosActive = currentPath.StartsWithSegments("/organizacion/cargos") ? "active" : string.Empty;
    // CRITICAL-04: el item "Listado" se marca activo solo cuando la ruta
    // exacta es /organizacion/habilidades (no /crear, /editar, /detalles).
    // "Nueva" se marca activo cuando la ruta es /organizacion/habilidades/crear.
    var habilidadesGroupActive = currentPath.StartsWithSegments("/organizacion/habilidades") ? "active" : string.Empty;
    var habilidadesListadoActive = string.Equals(currentPath, "/organizacion/habilidades", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    var habilidadesNuevaActive = string.Equals(currentPath, "/organizacion/habilidades/crear", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    // Puestos: grupo activo en /organizacion/puestos(/...); "Listado" activo
    // solo en la ruta exacta y "Nuevo" solo en /crear (mismo criterio que
    // Habilidades). Los destinos resuelven a partir de PR 2/PR 3.
    var puestosGroupActive = currentPath.StartsWithSegments("/organizacion/puestos") ? "active" : string.Empty;
    var puestosListadoActive = string.Equals(currentPath, "/organizacion/puestos", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    var puestosNuevoActive = string.Equals(currentPath, "/organizacion/puestos/crear", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
}

<div class="sidenav-menu">
