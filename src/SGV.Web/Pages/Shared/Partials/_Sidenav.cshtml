@{
    var currentPath = Context.Request.Path;
    var homeActive = currentPath == "/" ? "active" : string.Empty;
    var unidadesOrganizativasActive = currentPath.StartsWithSegments("/organizacion/unidades-organizativas") ? "active" : string.Empty;
    var cargosActive = currentPath.StartsWithSegments("/organizacion/cargos") ? "active" : string.Empty;
    // Usuarios: PR #2 expone el subítem debajo de un grupo colapsable
    // "Seguridad" pero las Razor Pages del listado/Create/Edit/Details
    // llegan en PR #3 y PR #4. El subítem se gated por rol
    // Administrador (sólo lo ven usuarios con el claim de rol); los
    // demás autenticados ven el grupo colapsable pero sin el link.
    // La autorización por acción (POST requiere Administrador) se
    // evalúa en cada Razor Page con [Authorize(Roles=Administrador)].
    var seguridadGroupActive = currentPath.StartsWithSegments("/seguridad") ? "active" : string.Empty;
    var usuariosActive = string.Equals(currentPath, "/seguridad/usuarios", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    var esAdministrador = User.IsInRole(SGV.Contracts.Seguridad.RolesSgv.Administrador);
    var vacantesGroupActive = currentPath.StartsWithSegments("/organizacion/vacantes") ? "active" : string.Empty;
    var vacantesListadoActive = string.Equals(currentPath, "/organizacion/vacantes", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    var vacantesNuevaActive = string.Equals(currentPath, "/organizacion/vacantes/crear", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    var puedeMutarVacantes = esAdministrador
        || User.IsInRole(SGV.Contracts.Seguridad.RolesSgv.GestorVacantes);
    // Personas: PR #2 expone el ítem pero la Razor Page llega en PR #3.
    // El groupActive aplica a /personas(/...); "Listado" se marca activo
    // sólo en la ruta exacta y "Nueva" sólo en /personas/crear (mismo
    // criterio que Habilidades). La autorización por rol (POST requiere
    // Administrador) se evalúa al cargar la página en PR #3.
    var personasGroupActive = currentPath.StartsWithSegments("/personas") ? "active" : string.Empty;
    var personasListadoActive = string.Equals(currentPath, "/personas", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    var personasNuevaActive = string.Equals(currentPath, "/personas/crear", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    // CRITICAL-04: el item "Listado" se marca activo solo cuando la ruta
    // exacta es /organizacion/habilidades (no /crear, /editar, /detalles).
    // "Nueva" se marca activo cuando la ruta es /organizacion/habilidades/crear.
    var habilidadesGroupActive = currentPath.StartsWithSegments("/organizacion/habilidades") ? "active" : string.Empty;
    var habilidadesListadoActive = string.Equals(currentPath, "/organizacion/habilidades", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    var habilidadesNuevaActive = string.Equals(currentPath, "/organizacion/habilidades/crear", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    // Puestos: grupo activo en /organizacion/puestos(/...); "Listado" activo
    // solo en la ruta exacta y "Nuevo" solo en /crear (mismo criterio que
    // Habilidades). Los destinos resuelven a partir de PR 2/PR 3.
    var puestosGroupActive = currentPath.StartsWithSegments("/organizacion/puestos") ? "active" : string.Empty;
    var puestosListadoActive = string.Equals(currentPath, "/organizacion/puestos", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    var puestosNuevoActive = string.Equals(currentPath, "/organizacion/puestos/crear", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    // Ocupaciones: grupo activo en /organizacion/ocupaciones(/...); "Listado" activo
    // solo en la ruta exacta y "Nueva" solo en /crear (mismo criterio que Puestos
    // y Habilidades). Los destinos resuelven a partir del Slice 2 (Index) y
    // Slice 3a (Create/Edit/Details).
    var ocupacionesGroupActive = currentPath.StartsWithSegments("/organizacion/ocupaciones") ? "active" : string.Empty;
    var ocupacionesListadoActive = string.Equals(currentPath, "/organizacion/ocupaciones", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
    var ocupacionesNuevaActive = string.Equals(currentPath, "/organizacion/ocupaciones/crear", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;
}

