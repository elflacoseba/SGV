@page "/organizacion/unidades-organizativas/detalles/{id:guid}"
@model SGV.Web.Pages.Organizacion.UnidadesOrganizativas.DetailsModel

@{
    ViewBag.title = Model.IsNotFound ? "Unidad no disponible" : "Detalle de unidad organizativa";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (Model.IsNotFound)
{
    <div class="alert alert-warning" role="alert">
        <h5 class="alert-heading">Unidad no disponible</h5>
        <p class="mb-0">La unidad organizativa solicitada no existe o ya no está disponible.</p>
    </div>
        @if (Model.IsRecoverable)
        {
            <form method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input name="returnPage" type="hidden" value="@Model.ReturnPage" />
                <input name="returnSearch" type="hidden" value="@Model.ReturnSearch" />
                <input name="returnSort" type="hidden" value="@Model.ReturnSort" />
                <input name="returnView" type="hidden" value="@Model.ReturnView" />
                <input name="returnStatus" type="hidden" value="@Model.ReturnStatus" />
                <input name="returnVigenteEn" type="hidden" value="@Model.ReturnVigenteEn" />
                <button type="submit" class="btn btn-success me-2" formaction="?handler=Reactivate&id=@Model.CurrentId">Reactivar</button>
            </form>
        }
}
else if (Model.Unidad is not null)
{
    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Model.Unidad.Codigo — @Model.Unidad.Nombre</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 fw-normal text-muted">Código</dt>
                        <dd class="col-sm-9">@Model.Unidad.Codigo</dd>

                        <dt class="col-sm-3 fw-normal text-muted">Nombre</dt>
                        <dd class="col-sm-9">@Model.Unidad.Nombre</dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Unidad.Descripcion))
                        {
                            <dt class="col-sm-3 fw-normal text-muted">Descripción</dt>
                            <dd class="col-sm-9">@Model.Unidad.Descripcion</dd>
                        }

                        <dt class="col-sm-3 fw-normal text-muted">Tipo</dt>
                        <dd class="col-sm-9"><span class="badge badge-soft-secondary">@Model.Unidad.TipoUnidadNombre</span></dd>

                        <dt class="col-sm-3 fw-normal text-muted">Unidad padre</dt>
                        <dd class="col-sm-9">
                            @if (Model.HasParent)
                            {
                                <span>@Model.Unidad.UnidadPadreCodigo — @Model.Unidad.UnidadPadreNombre</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Sin padre (unidad raíz)</span>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-normal text-muted">Vigencia</dt>
                        <dd class="col-sm-9">
                            @if (Model.Vigencia is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else if (string.IsNullOrEmpty(Model.Vigencia.BadgeClass))
                            {
                                <span>@Model.Vigencia.Texto</span>
                            }
                            else
                            {
                                <span class="badge @Model.Vigencia.BadgeClass fs-xs">@Model.Vigencia.Texto</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-3">
    <div class="col-12 d-flex gap-2">
        @if (!Model.IsNotFound && Model.Unidad is not null)
        {
            <a class="btn btn-warning" href="@Url.Page("/Organizacion/UnidadesOrganizativas/Edit", new { id = Model.Unidad.Id, returnPage = Model.ReturnPage, returnSearch = Model.ReturnSearch, returnSort = Model.ReturnSort, returnView = Model.ReturnView, returnStatus = Model.ReturnStatus, returnVigenteEn = Model.ReturnVigenteEn })">
                <i class="ti ti-pencil me-1"></i>Editar
            </a>
        }
        <a class="btn btn-outline-secondary" href="@Model.ReturnToListUrl">
            <i class="ti ti-arrow-left me-1"></i>Volver al listado
        </a>
    </div>
</div>
