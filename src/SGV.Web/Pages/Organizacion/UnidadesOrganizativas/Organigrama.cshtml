@page "/organizacion/unidades-organizativas/organigrama"
@model SGV.Web.Pages.Organizacion.UnidadesOrganizativas.OrganigramaModel
@using System.Text.Json

@{
    var treeJsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
}

@{
    ViewBag.title = "Organigrama";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.LoadErrorMessage</div>
}

@if (Model.HasCyclicNodes)
{
    // Issue #277: si la API detectó nodos involucrados en ciclos,
    // mostramos un warning explícito para que el operador sepa que
    // el árbol visible está incompleto. Los IDs se renderizan en
    // formato MonoSpace para facilitar copy/paste al DBA.
    <div class="alert alert-warning" role="alert">
        <h6 class="alert-heading mb-1"><i class="mdi mdi-alert-octagram-outline me-1"></i> Ciclos detectados en la jerarquía</h6>
        <p class="mb-1">
            El backend reportó <strong>@Model.CyclicNodeIds.Count</strong> nodo(s) que participan en al menos un ciclo. No se incluyen en el árbol renderizado. Corregí la jerarquía vía el portal admin o vía <code>PATCH /api/v1/unidades-organizativas/{id}/unidad-padre</code>.
        </p>
        <p class="mb-0 small text-muted">
            IDs: @foreach (var (id, idx) in Model.CyclicNodeIds.Select((x, i) => (x, i))) {<code>@id.ToString()</code>@if (idx < Model.CyclicNodeIds.Count - 1) {<span>, </span>}}
        </p>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-1">Organigrama de unidades organizativas</h4>
                <p class="text-muted mb-0">Explorá la jerarquía organizativa y navegá a los detalles de cada nodo.</p>
            </div>
            <div class="card-body">
                @if (Model.TreeItems.Count == 0 && string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
                {
                    <div class="text-center text-muted py-4">
                        <p class="mb-0">No hay unidades organizativas para mostrar en el organigrama.</p>
                        <a class="btn btn-outline-primary btn-sm mt-3" href="@Url.Page("/Organizacion/UnidadesOrganizativas/Index")">Volver al listado</a>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
                {
                    <div class="text-center text-muted py-4">
                        <a class="btn btn-outline-primary btn-sm" href="@Url.Page("/Organizacion/UnidadesOrganizativas/Index")">Volver al listado</a>
                    </div>
                }
                else
                {
                    // Issue #286: barra de acciones + switches de filtro visual.
                    // Solo se renderiza cuando hay árbol cargado (no en estados vacío
                    // ni de error) porque las acciones de exportación y los filtros
                    // no tienen sentido sin nodos. La clase `d-print-none` ya viene
                    // del bundle de Bootstrap servido en `app.min.css` y oculta la
                    // barra cuando el usuario dispara la impresión del PDF vía
                    // `window.print()`.
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-3 orgchart-toolbar d-print-none" data-orgchart-toolbar>
                        <div class="d-flex gap-2" data-orgchart-actions>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btn-export-png" data-orgchart-export="png" aria-label="Exportar organigrama a PNG">
                                <i class="mdi mdi-image-outline me-1" aria-hidden="true"></i>Exportar PNG
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-export-pdf" data-orgchart-export="pdf" aria-label="Exportar organigrama a PDF">
                                <i class="mdi mdi-file-pdf-box me-1" aria-hidden="true"></i>Exportar PDF
                            </button>
                        </div>
                        <div class="vr d-none d-md-block" aria-hidden="true"></div>
                        <div class="d-flex flex-wrap gap-3 orgchart-filters" data-orgchart-filters>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="toggle-show-code" data-orgchart-toggle="showCode" checked aria-describedby="toggle-show-code-label">
                                <label class="form-check-label" for="toggle-show-code" id="toggle-show-code-label">Mostrar código</label>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="toggle-show-expiradas" data-orgchart-toggle="showExpiradas" checked aria-describedby="toggle-show-expiradas-label">
                                <label class="form-check-label" for="toggle-show-expiradas" id="toggle-show-expiradas-label">Mostrar unidades expiradas</label>
                            </div>
                        </div>
                    </div>
                    <div id="orgchart" style="width:100%; min-height:500px; overflow:auto;" class="orgchart-container" data-orgchart-canvas></div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Issue #286: el chart de Google OrgChart trae inline `min-height:500px; overflow:auto;`
       que en modo print recorta el árbol y mete un scrollbar feo. La regla print se
       complementa con `.d-print-none` de la toolbar (Bootstrap) ya servido. */
    @@media print {
        .orgchart-container {
            min-height: 0 !important;
            overflow: visible !important;
        }
        .orgchart-container > div > table {
            margin: 0 auto;
        }
    }
</style>

<script>
    // Datos del organigrama pre-cargados server-side con el JWT bridged.
    // Se evita el fetch browser-side que rebotaba con 401 porque el JWT
    // vive en la cookie httpOnly del servidor y no es accesible al browser.
    window.__sgvTreeData = @Html.Raw(JsonSerializer.Serialize(Model.TreeItems, treeJsonOptions));
</script>

@section scripts {
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script src="/js/pages/organigrama.js"></script>
}