@page "/organizacion/ocupaciones/crear"
@model SGV.Web.Pages.Organizacion.Ocupaciones.CreateModel

@{
    ViewBag.title = "Crear ocupación";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Nueva ocupación</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()

                    @await Html.PartialAsync("_Form", Model)

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a class="btn btn-light" href="/organizacion/ocupaciones">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>