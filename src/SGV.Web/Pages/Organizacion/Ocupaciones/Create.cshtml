@page "/organizacion/ocupaciones/crear"
@model SGV.Web.Pages.Organizacion.Ocupaciones.CreateModel

@{
    ViewBag.title = "Crear ocupación";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Nueva ocupación</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()

                    @await Html.PartialAsync("_Form", Model)

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a class="btn btn-light" href="/organizacion/ocupaciones">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @* Issue #216 / OCC-PER-BUSC-01: el script compartido
       `usuario-persona-buscador.js` se incluye desde Create.cshtml
       (no desde el partial _Form) para no duplicarlo entre Create y Edit. *@
    <script src="/js/pages/usuario-persona-buscador.js"></script>

    @* Issue #266: tras un POST con persona faltante (o 409 que mapee a
       `Input.PersonaId`), el alert-danger superior, el
       `asp-validation-summary` y el `<span asp-validation-for="Input.PersonaId">`
       muestran el mensaje "Debe escoger una persona" hasta el próximo submit.
       El handler de cambio del hidden `Input_PersonaId` los oculta, ya que
       `usuario-persona-buscador.js` lo dispara al elegir o quitar persona
       desde el modal. *@
    <script src="/js/pages/ocupaciones-create.js"></script>
}