@* Shared field partial for create/edit of Ocupaciones. NOT a complete form. *@
@* Expects a model that implements IOcupacionForm. *@
@using SGV.Web.Pages.Organizacion.Ocupaciones
@model IOcupacionForm

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@* Issue #216 / OCC-PER-BUSC-01 + Slice 3 / PR 3 / issue #219: la card
   enriquecida editable (Email, Teléfono, Estado, Quitar, Cambiar) sale
   de la partial unificada `_PersonaCard.cshtml`. El binding a
   `Input.PersonaId` se conserva via hidden input separado (la partial
   emite su propio hidden `data-usuario-persona-display-input` con el
   display sincronizado). El ModalId es
   `ocupacion-persona-buscador-modal` (consistente con la convención
   previa del módulo). *@
@{
    var personaVinculada = Model.PersonaVinculada;
    var fallbackDisplay = !string.IsNullOrWhiteSpace(Model.PersonaDisplay)
        ? Model.PersonaDisplay
        : null;
}

<div class="row g-3">
    <div class="col-12">
        <label class="form-label" for="Input_PersonaId">Persona vinculada</label>
        <input type="hidden" asp-for="Input.PersonaId" />
        @await Html.PartialAsync(
            "~/Pages/Shared/Partials/_PersonaCard.cshtml",
            personaVinculada,
            new ViewDataDictionary(ViewData)
            {
                ["Mode"] = "editable",
                ["ShowStatusBadge"] = true,
                ["ShowQuitarCambiar"] = true,
                ["FallbackDisplay"] = fallbackDisplay,
                ["ModalId"] = "ocupacion-persona-buscador-modal",
                ["PersonaIdInputName"] = "Input.PersonaId",
                ["DisplayContainerId"] = "ocupacion-persona-display"
            })
        <span asp-validation-for="Input.PersonaId" class="text-danger"></span>
    </div>

@* Issue #216 / OCC-PER-BUSC-03: el modal reutilizado se invoca con
   `data-solo-sin-usuario="false"` vía ViewData para que el JS compartido
   condicional el flag. La vista del modal vive en
   `Pages/Seguridad/Usuarios/_PersonaBuscadorModal.cshtml` y se importa
   por path absoluto (precedente: `PersonaOcupaciones.cshtml` también
   importa `_CrossList.cshtml` por path absoluto). *@
@await Html.PartialAsync(
    "~/Pages/Seguridad/Usuarios/_PersonaBuscadorModal.cshtml",
    null,
    new ViewDataDictionary(ViewData)
    {
        ["ModalId"] = "ocupacion-persona-buscador-modal",
        ["HiddenInputName"] = "Input.PersonaId",
        ["HiddenInputId"] = "Input_PersonaId",
        ["DisplayContainerId"] = "ocupacion-persona-display",
        ["CurrentPersonaId"] = Model.Input.PersonaId,
        ["CurrentPersonaDisplay"] = Model.PersonaDisplay,
        ["SoloSinUsuario"] = false
    })

    <div class="col-md-6">
        <div class="form-floating">
            <select asp-for="Input.PuestoId" class="form-select"
                    asp-items="@(new SelectList(Model.PuestoOptions, "Id", "Nombre"))">
                <option value="">Seleccionar puesto...</option>
            </select>
            <label asp-for="Input.PuestoId">Puesto</label>
            <span asp-validation-for="Input.PuestoId" class="text-danger"></span>
        </div>
    </div>


    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.FechaInicio" type="date" class="form-control" placeholder="Fecha de inicio" />
            <label asp-for="Input.FechaInicio">Fecha de inicio</label>
            <span asp-validation-for="Input.FechaInicio" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-floating">
            <select asp-for="Input.TipoAsignacion" class="form-select"
                    asp-items="@(new SelectList(Enum.GetValues<SGV.Contracts.Ocupaciones.Enums.OcupacionTipoAsignacion>().Cast<SGV.Contracts.Ocupaciones.Enums.OcupacionTipoAsignacion>().Select(v => new { Value = (int)v, Text = v.ToString() }), "Value", "Text"))">
                <option value="">Seleccionar tipo...</option>
            </select>
            <label asp-for="Input.TipoAsignacion">Tipo de asignación</label>
            <span asp-validation-for="Input.TipoAsignacion" class="text-danger"></span>
        </div>
    </div>

    <div class="col-12">
        <div class="form-floating">
            <textarea asp-for="Input.Observaciones" class="form-control" placeholder="Observaciones" style="min-height: 80px"></textarea>
            <label asp-for="Input.Observaciones">Observaciones</label>
            <span asp-validation-for="Input.Observaciones" class="text-danger"></span>
        </div>
    </div>
</div>