@page "/organizacion/ocupaciones/editar/{id:guid}"
@model SGV.Web.Pages.Organizacion.Ocupaciones.EditModel

@{
    ViewBag.title = "Editar ocupación";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.IsRecoverable)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">La ocupación no está disponible para edición.</h5>
                    <p class="text-muted mb-3">Es posible que haya sido finalizada, eliminada o que haya ocurrido un error al consultarla.</p>
                    <a class="btn btn-primary" href="/organizacion/ocupaciones">
                        <i class="ti ti-arrow-left me-1"></i>Volver al listado
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Editar ocupación</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        @await Html.PartialAsync("_Form", Model)

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                            <a class="btn btn-light" href="/organizacion/ocupaciones">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Issue #216 / OCC-PER-BUSC-01: el script compartido se incluye
       SOLO cuando el form está renderizado (no en estado recuperable). *@
    @section scripts {
        <script src="/js/pages/usuario-persona-buscador.js"></script>

        @* Issue #266: tras un POST con persona faltante (o 409 que mapee a
           `Input.PersonaId`), el alert-danger superior, el
           `asp-validation-summary` y el `<span asp-validation-for="Input.PersonaId">`
           muestran el mensaje "Debe escoger una persona" hasta el próximo submit.
           El handler de cambio del hidden `Input_PersonaId` los oculta, ya que
           `usuario-persona-buscador.js` lo dispara al elegir o quitar persona
           desde el modal. El script es el mismo que Create porque ambos
           formularios comparten `_Form.cshtml`. *@
        <script src="/js/pages/ocupaciones-form.js"></script>
    }
}