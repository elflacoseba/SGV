@page "/organizacion/ocupaciones/editar/{id:guid}"
@model SGV.Web.Pages.Organizacion.Ocupaciones.EditModel

@{
    ViewBag.title = "Editar ocupación";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.IsRecoverable)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">La ocupación no está disponible para edición.</h5>
                    <p class="text-muted mb-3">Es posible que haya sido finalizada, eliminada o que haya ocurrido un error al consultarla.</p>
                    <a class="btn btn-primary" href="/organizacion/ocupaciones">
                        <i class="ti ti-arrow-left me-1"></i>Volver al listado
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Editar ocupación</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Input.PersonaId" class="form-select"
                                            asp-items="@(new SelectList(Model.PersonaOptions.Select(p => new { p.Id, NombreCompleto = $"{p.Apellidos}, {p.Nombres}" }), "Id", "NombreCompleto"))">
                                        <option value="">Seleccionar persona...</option>
                                    </select>
                                    <label asp-for="Input.PersonaId">Persona</label>
                                    <span asp-validation-for="Input.PersonaId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Input.PuestoId" class="form-select"
                                            asp-items="@(new SelectList(Model.PuestoOptions, "Id", "Nombre"))">
                                        <option value="">Seleccionar puesto...</option>
                                    </select>
                                    <label asp-for="Input.PuestoId">Puesto</label>
                                    <span asp-validation-for="Input.PuestoId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Input.FechaInicio" type="date" class="form-control" placeholder="Fecha de inicio" />
                                    <label asp-for="Input.FechaInicio">Fecha de inicio</label>
                                    <span asp-validation-for="Input.FechaInicio" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Input.TipoAsignacion" class="form-select"
                                            asp-items="@(new SelectList(Enum.GetValues<SGV.Contracts.Ocupaciones.Enums.OcupacionTipoAsignacion>().Cast<SGV.Contracts.Ocupaciones.Enums.OcupacionTipoAsignacion>().Select(v => new { Value = (int)v, Text = v.ToString() }), "Value", "Text"))">
                                        <option value="">Seleccionar tipo...</option>
                                    </select>
                                    <label asp-for="Input.TipoAsignacion">Tipo de asignación</label>
                                    <span asp-validation-for="Input.TipoAsignacion" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Input.Observaciones" class="form-control" placeholder="Observaciones" style="min-height: 80px"></textarea>
                                    <label asp-for="Input.Observaciones">Observaciones</label>
                                    <span asp-validation-for="Input.Observaciones" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                            <a class="btn btn-light" href="/organizacion/ocupaciones">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}