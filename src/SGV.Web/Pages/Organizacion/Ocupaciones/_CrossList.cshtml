@* Shared cross-page partial for PersonaOcupaciones and PuestoOcupaciones. *@
@* Expects a model that implements IOcupacionesCrossList. *@
@using SGV.Web.Pages.Organizacion.Ocupaciones
@model IOcupacionesCrossList

@if (Model.IsNotFound)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">@Model.NotFoundHeading</h5>
                    <p class="text-muted mb-3">@Model.NotFoundBody</p>
                    <a class="btn btn-outline-secondary" href="@Model.NotFoundReturnUrl">
                        <i class="ti ti-arrow-left me-1"></i>@Model.NotFoundReturnLabel
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card" data-ocupaciones-cross-card>
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h4 class="card-title mb-1">@Model.HeaderTitle</h4>
                        <p class="text-muted mb-0">
                            @Model.HeaderSubtitleLabel: <strong>@Model.HeaderSubtitleValue</strong>@if (Model.HeaderSubtitleBadge is not null)
                            {
                                <span class="badge @Model.HeaderSubtitleBadgeClass fs-xs">@Model.HeaderSubtitleBadge</span>
                            }
                        </p>
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                        <span class="badge badge-soft-primary fs-xs">@Model.TotalCount registro(s)</span>
                        @* T-7.2 (NAV-007): "Abrir Vacante" cuando el Puesto
                           no tiene Vacante abierta y el usuario es admin.
                           Default null en PersonaOcupacionesModel. *@
                        @if (Model.EsAdministrador && Model.AbrirVacanteUrl is not null)
                        {
                            <a class="btn btn-primary btn-sm"
                               href="@Model.AbrirVacanteUrl">
                                <i class="ti ti-briefcase-plus me-1"></i>Abrir Vacante
                            </a>
                        }
                        @* REQ-OCC-NAV-006: alta contextual pre-carga el id dueño en Create. *@
                        @if (Model.EsAdministrador && Model.NewOcupacionRouteValues is not null)
                        {
                            <a class="btn btn-primary btn-sm"
                               href="@Url.Page("/Organizacion/Ocupaciones/Create", Model.NewOcupacionRouteValues)">
                                <i class="ti ti-plus me-1"></i>@Model.NewOcupacionButtonLabel
                            </a>
                        }
                        @if (Model.VerOcupacionVigenteRouteValues is not null)
                        {
                            <a class="btn btn-outline-primary btn-sm"
                               href="@Url.Page("/Organizacion/Ocupaciones/Details", Model.VerOcupacionVigenteRouteValues)">
                                <i class="ti ti-eye me-1"></i>Ver Ocupación vigente
                            </a>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.DisponibilidadMessage))
                {
                    <div class="card-body pb-0">
                        <div class="alert alert-info" role="status">@Model.DisponibilidadMessage</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="card-body pb-0">
                        <div class="alert alert-danger" role="alert" data-ocupaciones-cross-error>@Model.ErrorMessage</div>
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-custom table-centered table-hover w-100 mb-0">
                        <thead class="bg-light align-middle bg-opacity-25 thead-sm">
                            <tr class="text-uppercase fs-xxs">
                                <th>@Model.CrossEntityColumnHeader</th>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th class="text-center" style="width: 1%">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Count == 0)
                            {
                                <tr>
                                    <td class="text-center text-muted py-4" colspan="6" data-ocupaciones-cross-empty>
                                        @Model.EmptyMessage
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Items)
                                {
                                    var crossEntityValue = Model.ColumnSelector == CrossEntityColumn.Puesto
                                        ? item.PuestoNombre
                                        : item.PersonaNombre;
                                    <tr data-ocupaciones-cross-row>
                                        <td class="@Model.CrossEntityCellClass">
                                            @if (Model.RenderCrossEntityCellAsBadge)
                                            {
                                                <span class="badge badge-soft-secondary fs-xs">@crossEntityValue</span>
                                            }
                                            else
                                            {
                                                @crossEntityValue
                                            }
                                        </td>
                                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                        <td>@(item.FechaFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@item.TipoAsignacion</td>
                                        <td>
                                            <span class="badge @(item.EsVigente ? "badge-soft-success" : item.EsFinalizada ? "badge-soft-warning" : "badge-soft-danger") fs-xs">
                                                @item.Estado
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                <a class="btn btn-info btn-icon btn-sm rounded-circle"
                                                   href="@Url.Page("/Organizacion/Ocupaciones/Details", new { id = item.Id })"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-title="Ver detalle de la ocupación"
                                                   aria-label="Detalle de @crossEntityValue">
                                                    <i class="ti ti-eye fs-lg"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <span class="text-muted">Total vigente: @Model.TotalCount</span>
                    @* REQ-OCC-NAV-005: volver siempre al Details dueño. *@
                    <a class="btn btn-outline-secondary btn-sm" href="@Model.BackLinkUrl">
                        <i class="ti ti-arrow-left me-1"></i>Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
}
