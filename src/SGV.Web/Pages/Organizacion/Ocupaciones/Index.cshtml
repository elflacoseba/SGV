@page "/organizacion/ocupaciones"
@model SGV.Web.Pages.Organizacion.Ocupaciones.IndexModel

@{
    ViewBag.title = "Ocupaciones";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.LoadErrorMessage</div>
}

<div class="row">
    <div class="col-12">
        <div class="card" data-table>
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h4 class="card-title mb-1">
                        @(Model.IsDeletedView ? "Listado de ocupaciones eliminadas" : "Listado de ocupaciones activas")
                    </h4>
                    <p class="text-muted mb-0">
                        @(Model.IsDeletedView
                            ? "Visualiza y reactiva ocupaciones dadas de baja lógica."
                            : "Consulta, búsqueda y baja lógica del módulo de Ocupaciones.")
                    </p>
                </div>
                <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                    <div class="btn-group" role="group" aria-label="Filtrar por estado">
                        <a class="btn btn-sm @(Model.IsDeletedView ? "btn-light" : "btn-primary")"
                           href="@Url.Page("/Organizacion/Ocupaciones/Index", Model.BuildToggleSegmentoRouteValues(null))">Activas</a>
                        <a class="btn btn-sm @(Model.IsDeletedView ? "btn-primary" : "btn-light")"
                           href="@Url.Page("/Organizacion/Ocupaciones/Index", Model.BuildToggleSegmentoRouteValues("eliminadas"))">Eliminadas</a>
                    </div>
                    <span class="badge badge-soft-primary fs-xs">@Model.TotalCount registro(s)</span>
                    @* REQ-OCC-LST-003: en vista Eliminadas se oculta la acción Nuevo;
                       la creación de ocupaciones es flujo de alta, no de historial. *@
                    @if (!Model.IsDeletedView && Model.EsAdministrador)
                    {
                        <a class="btn btn-primary btn-sm" href="/organizacion/ocupaciones/crear">
                            <i class="ti ti-plus me-1"></i>Crear ocupación
                        </a>
                    }
                </div>
            </div>
            <div class="card-header border-0">
                <form class="row g-2 align-items-center w-100" method="get">
                    <div class="col-md-6 col-xl-4">
                        <div class="app-search">
                            <input class="form-control" name="search" placeholder="Buscar..."
                                   data-bs-toggle="tooltip" data-bs-placement="top"
                                   data-bs-title="Buscar por persona, puesto u observaciones..."
                                   type="search" value="@Model.Search" />
                            <i class="ti ti-search app-search-icon text-muted"></i>
                        </div>
                    </div>
                    <input name="sort" type="hidden" value="@Model.Sort" />
                    <input name="status" type="hidden" value="@Model.Segmento" />
                    <div class="col-auto">
                        <button class="btn btn-primary" type="submit">Buscar</button>
                    </div>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-centered table-hover w-100 mb-0">
                    <thead class="bg-light align-middle bg-opacity-25 thead-sm">
                        <tr class="text-uppercase fs-xxs">
                            <th>Persona</th>
                            <th>Puesto</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th class="text-center" style="width: 1%">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td class="text-center text-muted py-4" colspan="7">
                                    @(Model.IsDeletedView ? "No se encontraron ocupaciones eliminadas." : "No se encontraron ocupaciones activas.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-medium">@item.PersonaNombre</td>
                                    <td>
                                        <span class="badge badge-soft-secondary fs-xs">@item.PuestoNombre</span>
                                    </td>
                                    <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@(item.FechaFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td>@item.TipoAsignacion</td>
                                    <td>
                                        <span class="badge @(item.EsVigente ? "badge-soft-success" : item.EsFinalizada ? "badge-soft-warning" : "badge-soft-danger") fs-xs">
                                            @item.Estado
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            @* REQ-OCC-LST-006: Ver disponible para todo autenticado;
                                               Editar/Eliminar sólo Admin en Vigente; Reactivar sólo Admin en Eliminadas. *@
                                            <a class="btn btn-info btn-icon btn-sm rounded-circle"
                                               href="@Model.BuildDetailsUrl(item.Id)"
                                               data-bs-toggle="tooltip" data-bs-title="Ver detalle"
                                               aria-label="Detalle de @item.PersonaNombre en @item.PuestoNombre">
                                                <i class="ti ti-eye fs-lg"></i>
                                            </a>
                                            @if (!Model.IsDeletedView && Model.EsAdministrador)
                                            {
                                                <a class="btn btn-warning btn-icon btn-sm rounded-circle"
                                                   href="@Model.BuildEditUrl(item.Id)"
                                                   data-bs-toggle="tooltip" data-bs-title="Editar"
                                                   aria-label="Editar @item.PersonaNombre en @item.PuestoNombre">
                                                    <i class="ti ti-edit fs-lg"></i>
                                                </a>
                                                <form data-ocupacion-delete-form method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input name="id" type="hidden" value="@item.Id" />
                                                    <input name="page" type="hidden" value="@Model.CurrentPage" />
                                                    <input name="search" type="hidden" value="@Model.Search" />
                                                    <input name="sort" type="hidden" value="@Model.Sort" />
                                                    <input name="status" type="hidden" value="@Model.Segmento" />
                                                    <button aria-label="Eliminar @item.PersonaNombre en @item.PuestoNombre"
                                                            class="btn btn-danger btn-icon btn-sm rounded-circle"
                                                            data-ocupacion-delete-button
                                                            data-ocupacion-persona="@item.PersonaNombre"
                                                            data-ocupacion-puesto="@item.PuestoNombre"
                                                            data-bs-toggle="tooltip"
                                                            data-bs-title="Eliminar"
                                                            formaction="?handler=Delete"
                                                            type="submit">
                                                        <i class="ti ti-trash fs-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (Model.IsDeletedView && Model.EsAdministrador)
                                            {
                                                <form data-ocupacion-reactivate-form method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input name="id" type="hidden" value="@item.Id" />
                                                    <input name="page" type="hidden" value="@Model.CurrentPage" />
                                                    <input name="search" type="hidden" value="@Model.Search" />
                                                    <input name="sort" type="hidden" value="@Model.Sort" />
                                                    <input name="status" type="hidden" value="@Model.Segmento" />
                                                    <button aria-label="Reactivar @item.PersonaNombre en @item.PuestoNombre"
                                                            class="btn btn-success btn-icon btn-sm rounded-circle"
                                                            data-ocupacion-reactivate-button
                                                            data-ocupacion-persona="@item.PersonaNombre"
                                                            data-ocupacion-puesto="@item.PuestoNombre"
                                                            data-bs-toggle="tooltip"
                                                            data-bs-title="Reactivar"
                                                            formaction="?handler=Reactivate"
                                                            type="submit">
                                                        <i class="ti ti-refresh fs-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">
                <span class="text-muted">Página @Model.CurrentPage de @Model.TotalPages</span>
                <nav aria-label="Paginación de ocupaciones">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : null)">
                            <a class="page-link" href="@Url.Page("/Organizacion/Ocupaciones/Index", Model.BuildPagedRouteValues(1))">Primera</a>
                        </li>
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : null)">
                            <a class="page-link" href="@Url.Page("/Organizacion/Ocupaciones/Index", Model.BuildPagedRouteValues(Math.Max(1, Model.CurrentPage - 1)))">Anterior</a>
                        </li>
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : null)">
                            <a class="page-link" href="@Url.Page("/Organizacion/Ocupaciones/Index", Model.BuildPagedRouteValues(Model.CurrentPage + 1))">Siguiente</a>
                        </li>
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : null)">
                            <a class="page-link" href="@Url.Page("/Organizacion/Ocupaciones/Index", Model.BuildPagedRouteValues(Model.TotalPages))">Última</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>