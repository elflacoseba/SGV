@page "/organizacion/cargos/{id:guid}/habilidades"
@model SGV.Web.Pages.Organizacion.Cargos.HabilidadesModel

@section styles {
    <link rel="stylesheet" href="/plugins/sweetalert2/sweetalert2.min.css" />
}

@{
    ViewBag.title = "Habilidades del cargo";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.IsRecoverable)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">El cargo solicitado no está disponible.</h5>
                    <p class="text-muted mb-3">Es posible que el cargo haya sido eliminado o que haya ocurrido un error al consultarlo.</p>
                    <a class="btn btn-primary" href="/organizacion/cargos">
                        <i class="ti ti-arrow-left me-1"></i>Volver al listado
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else if (!Model.EsAdministrador)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-shield-x fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">Acceso denegado</h5>
                    <p class="text-muted mb-3">Esta sección requiere rol Administrador.</p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row mb-3">
        <div class="col-12">
            <h4 class="mb-0">Habilidades de @Model.CargoNombre</h4>
        </div>
    </div>

    @if (Model.Skills.Count == 0)
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="alert alert-info" role="alert">
                    Este cargo no tiene habilidades asignadas. Usá el formulario de abajo para agregar la primera.
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Habilidad</th>
                                        <th>NivelRequerido</th>
                                        <th style="width: 120px;">Ponderación</th>
                                        <th style="width: 110px;">Obligatoria</th>
                                        <th style="width: 200px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var skill in Model.Skills)
                                    {
                                        var nivelKey = $"Actualizar[{skill.SkillId}].NivelRequeridoId";
                                        var ponderacionKey = $"Actualizar[{skill.SkillId}].Ponderacion";
                                        var obligatoriaKey = $"Actualizar[{skill.SkillId}].EsObligatoria";
                                        var nivelError = ViewData.ModelState[nivelKey]?.Errors.FirstOrDefault()?.ErrorMessage;
                                        var ponderacionError = ViewData.ModelState[ponderacionKey]?.Errors.FirstOrDefault()?.ErrorMessage;
                                        var obligatoriaError = ViewData.ModelState[obligatoriaKey]?.Errors.FirstOrDefault()?.ErrorMessage;
                                        <tr data-skill-management-row>
                                            <td>
                                                <div class="fw-semibold">@skill.Skill.Nombre</div>
                                                <div class="text-muted small">@skill.Skill.Codigo</div>
                                            </td>
                                            <td colspan="4">
                                                <form method="post" asp-page-handler="Actualizar" class="row g-2 align-items-center" data-skill-update-form>
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="skillId" value="@skill.SkillId" />
                                                    <div class="col-md-4">
                                                        <select name="Actualizar[@skill.SkillId].NivelRequeridoId" class="form-select form-select-sm" data-skill-editable disabled>
                                                            @foreach (var nivel in Model.NivelOptions)
                                                            {
                                                                if (nivel.Id == skill.NivelRequeridoId)
                                                                {
                                                                    <option value="@nivel.Id" selected="selected">@nivel.Nombre</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@nivel.Id">@nivel.Nombre</option>
                                                                }
                                                            }
                                                        </select>
                                                        @if (!string.IsNullOrEmpty(nivelError))
                                                        {
                                                            <div class="invalid-feedback d-block">@nivelError</div>
                                                        }
                                                    </div>
                                                    <div class="col-md-3">
                                                        <input type="number"
                                                               name="Actualizar[@skill.SkillId].Ponderacion"
                                                               value="@skill.Ponderacion.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                               step="0.01"
                                                               min="0.01"
                                                               max="100.00"
                                                               class="form-control form-control-sm"
                                                               data-skill-editable
                                                               disabled />
                                                        @if (!string.IsNullOrEmpty(ponderacionError))
                                                        {
                                                            <div class="invalid-feedback d-block">@ponderacionError</div>
                                                        }
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="form-check">
                                                            @if (skill.EsObligatoria)
                                                            {
                                                                <input type="checkbox" name="Actualizar[@skill.SkillId].EsObligatoria" value="true" checked="checked" class="form-check-input" data-skill-editable disabled />
                                                            }
                                                            else
                                                            {
                                                                <input type="checkbox" name="Actualizar[@skill.SkillId].EsObligatoria" value="true" class="form-check-input" data-skill-editable disabled />
                                                            }
                                                            <label class="form-check-label small">Obligatoria</label>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(obligatoriaError))
                                                        {
                                                            <div class="invalid-feedback d-block">@obligatoriaError</div>
                                                        }
                                                    </div>
                                                    <div class="col-md-3 d-flex gap-1">
                                                        <button type="button" class="btn btn-sm btn-outline-primary" data-skill-edit-button>Editar</button>
                                                        <button type="submit" class="btn btn-sm btn-primary d-none" data-skill-save-button>Guardar</button>
                                                    </div>
                                                </form>
                                                <form method="post" asp-page-handler="Quitar" class="d-flex justify-content-end mt-2" data-skill-delete-form>
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="skillId" value="@skill.SkillId" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            data-skill-delete-button
                                                            data-skill-item-name="@skill.Skill.Nombre">Quitar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row mt-4">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Asignar nueva habilidad</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Asignar">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="AsignarInput.SkillId" class="form-label">Habilidad</label>
                                <select asp-for="AsignarInput.SkillId" class="form-select">
                                    <option value="">Seleccionar habilidad...</option>
                                    @foreach (var habilidad in Model.HabilidadesDisponibles)
                                    {
                                        <option value="@habilidad.Id">@habilidad.Nombre (@habilidad.Codigo)</option>
                                    }
                                </select>
                                <span asp-validation-for="AsignarInput.SkillId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AsignarInput.NivelRequeridoId" class="form-label">Nivel requerido</label>
                                <select asp-for="AsignarInput.NivelRequeridoId" class="form-select">
                                    <option value="">Seleccionar nivel...</option>
                                    @foreach (var nivel in Model.NivelOptions)
                                    {
                                        <option value="@nivel.Id">@nivel.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="AsignarInput.NivelRequeridoId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AsignarInput.Ponderacion" class="form-label">Ponderación</label>
                                <input asp-for="AsignarInput.Ponderacion"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       max="100.00"
                                       class="form-control" />
                                <span asp-validation-for="AsignarInput.Ponderacion" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check">
                                    <input asp-for="AsignarInput.EsObligatoria" class="form-check-input" />
                                    <label asp-for="AsignarInput.EsObligatoria" class="form-check-label">Obligatoria</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Asignar habilidad</button>
                        </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section scripts {
    <script src="/plugins/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="/js/pages/skill-management.js"></script>
}
