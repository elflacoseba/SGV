@page "/organizacion/puestos/detalles/{id:guid}"
@model SGV.Web.Pages.Organizacion.Puestos.DetailsModel
@{
    ViewBag.title = "Detalle de puesto";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (Model.IsNotFound)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">El puesto solicitado no está disponible.</h5>
                    <p class="text-muted mb-0">Es posible que el puesto haya sido eliminado o que haya ocurrido un error al consultarlo.</p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-1">@Model.Puesto!.Nombre</h4>
                    <p class="text-muted mb-0">@Model.Puesto!.Codigo</p>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Código</dt>
                        <dd class="col-sm-9">@Model.Puesto!.Codigo</dd>

                        <dt class="col-sm-3 text-muted">Nombre</dt>
                        <dd class="col-sm-9">@Model.Puesto!.Nombre</dd>

                        <dt class="col-sm-3 text-muted">Descripción</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Puesto!.Descripcion) ? "—" : Model.Puesto!.Descripcion)</dd>

                        <dt class="col-sm-3 text-muted">Unidad organizativa</dt>
                        <dd class="col-sm-9">
                            <span class="badge badge-soft-secondary">@Model.Puesto!.UnidadOrganizativaNombre</span>
                        </dd>

                        <dt class="col-sm-3 text-muted">Cargo</dt>
                        <dd class="col-sm-9">
                            <span class="badge badge-soft-info">@Model.Puesto!.CargoNombre</span>
                        </dd>

                        <dt class="col-sm-3 text-muted">Puesto superior</dt>
                        <dd class="col-sm-9">
                            @if (Model.Puesto!.PuestoSuperiorId.HasValue)
                            {
                                <a class="btn btn-soft-secondary btn-icon btn-sm rounded-circle"
                                   href="@Model.BuildSuperiorUrl(Model.Puesto!.PuestoSuperiorId.Value)"
                                   data-bs-toggle="tooltip"
                                   data-bs-title="Ver puesto superior"
                                   aria-label="Ver puesto superior">
                                    <i class="ti ti-hierarchy fs-lg"></i>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Sin superior</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-3">
    <div class="col-12 d-flex gap-2">
        @if (!Model.IsNotFound)
        {
            <a class="btn btn-warning" href="@Model.BuildEditUrl(Model.Puesto!.Id)">
                <i class="ti ti-pencil me-1"></i>Editar
            </a>
            @* Slice 3b (REQ-OCC-NAV-003): enlace "Ver ocupaciones" visible
               para todo usuario autenticado cuando el puesto está activo.
               La API ya devuelve null para puestos inactivos, así que
               Puesto is not null es el proxy de "activo". La página
               cruzada NO requiere admin para lectura. *@
            <a class="btn btn-primary" href="@Url.Page("/Organizacion/Puestos/PuestoOcupaciones", new { id = Model.Puesto!.Id })">
                <i class="ti ti-history me-1"></i>Ver ocupaciones
            </a>
        }
        <a class="btn btn-outline-secondary" href="@Model.BuildIndexUrl()">
            <i class="ti ti-arrow-left me-1"></i>Volver al listado
        </a>
    </div>
</div>