@page "/organizacion/puestos/{id:guid}/ocupaciones"
@model SGV.Web.Pages.Organizacion.Puestos.PuestoOcupacionesModel

@{
    ViewBag.title = "Ocupaciones del puesto";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (Model.IsNotFound)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">El puesto solicitado no está disponible.</h5>
                    <p class="text-muted mb-3">Es posible que el puesto haya sido desactivado, eliminado o que haya ocurrido un error al consultarlo.</p>
                    <a class="btn btn-outline-secondary" href="/organizacion/puestos">
                        <i class="ti ti-arrow-left me-1"></i>Volver al listado de puestos
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card" data-ocupaciones-puesto-card>
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h4 class="card-title mb-1">Ocupaciones vigentes del puesto</h4>
                        <p class="text-muted mb-0">
                            Puesto: <strong>@Model.PuestoNombre</strong> <span class="badge badge-soft-secondary fs-xs">@Model.PuestoCodigo</span>
                        </p>
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                        <span class="badge badge-soft-primary fs-xs">@Model.TotalCount registro(s)</span>
                        @* REQ-OCC-NAV-006: alta contextual pre-carga puestoId en Create. *@
                        @if (Model.EsAdministrador)
                        {
                            <a class="btn btn-primary btn-sm"
                               href="@Url.Page("/Organizacion/Ocupaciones/Create", Model.BuildNewOcupacionRouteValues())">
                                <i class="ti ti-plus me-1"></i>Nueva ocupación
                            </a>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="card-body pb-0">
                        <div class="alert alert-danger" role="alert" data-ocupaciones-puesto-error>@Model.ErrorMessage</div>
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-custom table-centered table-hover w-100 mb-0">
                        <thead class="bg-light align-middle bg-opacity-25 thead-sm">
                            <tr class="text-uppercase fs-xxs">
                                <th>Persona</th>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th class="text-center" style="width: 1%">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Count == 0)
                            {
                                <tr>
                                    <td class="text-center text-muted py-4" colspan="6" data-ocupaciones-puesto-empty>
                                        Este puesto no tiene ocupaciones vigentes asignadas.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr data-ocupaciones-puesto-row>
                                        <td class="fw-medium">@item.PersonaNombre</td>
                                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                        <td>@(item.FechaFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@item.TipoAsignacion</td>
                                        <td>
                                            <span class="badge @(item.EsVigente ? "badge-soft-success" : item.EsFinalizada ? "badge-soft-warning" : "badge-soft-danger") fs-xs">
                                                @item.Estado
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                <a class="btn btn-info btn-icon btn-sm rounded-circle"
                                                   href="@Url.Page("/Organizacion/Ocupaciones/Details", new { id = item.Id })"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-title="Ver detalle de la ocupación"
                                                   aria-label="Detalle de @item.PersonaNombre">
                                                    <i class="ti ti-eye fs-lg"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <span class="text-muted">Total vigente: @Model.TotalCount</span>
                    @* REQ-OCC-NAV-005: volver siempre al Details dueño del puesto. *@
                    <a class="btn btn-outline-secondary btn-sm" href="@Model.BuildPuestoDetailsUrl()">
                        <i class="ti ti-arrow-left me-1"></i>Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
}