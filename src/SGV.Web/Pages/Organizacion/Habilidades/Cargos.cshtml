@page "/organizacion/habilidades/{id:guid}/cargos"
@model SGV.Web.Pages.Organizacion.Habilidades.HabilidadesCargosModel

@{
    ViewBag.title = "Cargos de la habilidad";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.IsRecoverable)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">La habilidad solicitada no está disponible.</h5>
                    <p class="text-muted mb-3">Es posible que la habilidad haya sido eliminada o que haya ocurrido un error al consultarla.</p>
                    <a class="btn btn-primary" href="@Model.BuildVolverAlListadoUrl()">
                        <i class="ti ti-arrow-left me-1"></i>Volver al listado
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card" data-table>
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h4 class="card-title mb-1">
                            @(Model.IsDeletedView ? "Cargos eliminados de la habilidad" : "Cargos asociados a la habilidad")
                        </h4>
                        <p class="text-muted mb-0">
                            Habilidad: <strong>@Model.HabilidadNombre</strong>
                        </p>
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                        <div class="btn-group" role="group" aria-label="Filtrar por estado">
                            <a class="btn btn-sm @(Model.IsDeletedView ? "btn-light" : "btn-primary")" href="@Url.Page("/Organizacion/Habilidades/Cargos", Model.BuildToggleSegmentoRouteValues(null))">Activas</a>
                            <a class="btn btn-sm @(Model.IsDeletedView ? "btn-primary" : "btn-light")" href="@Url.Page("/Organizacion/Habilidades/Cargos", Model.BuildToggleSegmentoRouteValues("eliminadas"))">Eliminadas</a>
                        </div>
                        <span class="badge badge-soft-primary fs-xs">@Model.TotalCount registro(s)</span>
                        <a class="btn btn-outline-secondary btn-sm" href="@Model.BuildVolverAlListadoUrl()">
                            <i class="ti ti-arrow-left me-1"></i>Volver al listado
                        </a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-custom table-centered table-hover w-100 mb-0">
                        <thead class="bg-light align-middle bg-opacity-25 thead-sm">
                            <tr class="text-uppercase fs-xxs">
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Nivel</th>
                                <th class="text-center" style="width: 1%">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Count == 0)
                            {
                                <tr>
                                    <td class="text-center text-muted py-4" colspan="4">
                                        @(Model.IsDeletedView
                                            ? "No hay cargos eliminados asociados a esta habilidad."
                                            : "No hay cargos asociados a esta habilidad.")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.Codigo</td>
                                        <td>@item.Nombre</td>
                                        <td>
                                            <span class="badge badge-soft-secondary fs-xs">@item.NivelNombre</span>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                <a class="btn btn-info btn-icon btn-sm rounded-circle" href="@Url.Page("/Organizacion/Cargos/Details", Model.BuildCargoDetailsRouteValues(item.CargoId))" data-bs-toggle="tooltip" data-bs-title="Ver detalle del cargo" aria-label="Detalle de @item.Nombre">
                                                    <i class="ti ti-eye fs-lg"></i>
                                                </a>
                                                @if (Model.EsAdministrador)
                                                {
                                                    <a class="btn btn-warning btn-icon btn-sm rounded-circle" href="@Url.Page("/Organizacion/Cargos/Habilidades", Model.BuildGestionarHabilidadesRouteValues(item.CargoId))" data-bs-toggle="tooltip" data-bs-title="Gestionar habilidades del cargo" aria-label="Gestionar habilidades de @item.Nombre">
                                                        <i class="ti ti-edit fs-lg"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <span class="text-muted">Página @Model.CurrentPage de @Model.TotalPages</span>
                    <nav aria-label="Paginación de cargos por habilidad">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : null)">
                                <a class="page-link" href="@Url.Page("/Organizacion/Habilidades/Cargos", Model.BuildPaginationRouteValues(Math.Max(1, Model.CurrentPage - 1)))">Anterior</a>
                            </li>
                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : null)">
                                    <a class="page-link" href="@Url.Page("/Organizacion/Habilidades/Cargos", Model.BuildPaginationRouteValues(pageNumber))">@pageNumber</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : null)">
                                <a class="page-link" href="@Url.Page("/Organizacion/Habilidades/Cargos", Model.BuildPaginationRouteValues(Model.CurrentPage + 1))">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
}