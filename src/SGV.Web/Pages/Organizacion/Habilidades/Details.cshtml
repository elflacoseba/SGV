@page "/organizacion/habilidades/detalles/{id:guid}"
@model SGV.Web.Pages.Organizacion.Habilidades.DetailsModel
@{
    ViewBag.title = "Detalle de habilidad";
    ViewBag.subtitle = "Organización";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (Model.IsNotFound)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">La habilidad solicitada no está disponible.</h5>
                    <p class="text-muted mb-0">Es posible que la habilidad haya sido eliminada o que haya ocurrido un error al consultarla.</p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-1">@Model.Habilidad!.Nombre</h4>
                    <p class="text-muted mb-0">@Model.Habilidad!.Codigo</p>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Código</dt>
                        <dd class="col-sm-9">@Model.Habilidad!.Codigo</dd>

                        <dt class="col-sm-3 text-muted">Nombre</dt>
                        <dd class="col-sm-9">@Model.Habilidad!.Nombre</dd>

                        <dt class="col-sm-3 text-muted">Categoría</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrWhiteSpace(Model.Habilidad!.CategoriaNombre))
                            {
                                <span class="badge badge-soft-secondary">@Model.Habilidad!.CategoriaNombre</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>

                        <dt class="col-sm-3 text-muted">Descripción</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Habilidad!.Descripcion) ? "—" : Model.Habilidad!.Descripcion)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-3">
    <div class="col-12 d-flex gap-2">
        @if (!Model.IsNotFound)
        {
            <a class="btn btn-warning" href="@Url.Page("/Organizacion/Habilidades/Edit", new { id = Model.Habilidad!.Id, p = Model.CurrentPage, search = Model.Search, sort = Model.Sort, returnStatus = Model.ReturnStatus })">
                <i class="ti ti-pencil me-1"></i>Editar
            </a>
        }
        <a class="btn btn-outline-secondary" href="@Model.ReturnToListUrl">
            <i class="ti ti-arrow-left me-1"></i>Volver al listado
        </a>
    </div>
</div>