@page "/auth/cambiar-contrasena"
@model SGV.Web.Pages.Auth.CambiarContrasenaModel

@{
    ViewBag.title = "Cambiar contraseña";
}

<div class="auth-box overflow-hidden align-items-center d-flex">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xxl-4 col-md-6 col-sm-8">
                <div class="auth-brand text-center mb-4">
                    <a class="logo-dark" href="/">
                        <img alt="SGV" src="/images/logo-black.png" />
                    </a>
                    <h4 class="fw-bold mt-3">Cambiar contraseña</h4>
                    <p class="text-muted w-lg-75 mx-auto">
                        Tu sesión se cerrará al confirmar para que vuelvas a iniciar sesión
                        con la nueva contraseña.
                    </p>
                </div>

                <div class="card p-4">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.CurrentPassword" class="form-label">Contraseña actual</label>
                            <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3" data-password="bar">
                            <label asp-for="Input.NewPassword" class="form-label">Nueva contraseña</label>
                            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                            <div class="password-bar my-2"></div>
                            <p class="text-muted fs-xs mb-0">
                                Usá al menos 6 caracteres con mayúsculas, minúsculas, números y símbolos.
                            </p>
                            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-primary fw-semibold py-2" type="submit">Cambiar contraseña</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/pages/auth-password.js"></script>
    <script>
        // Inicializar validación manual para que los mensajes de error se
        // muestren apenas el usuario deja el campo vacío, no al hacer submit.
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.querySelector('form');
            if (form && $.validator && $.validator.unobtrusive) {
                $(form).removeData('validator').removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse(form);
            }
        });
    </script>
}