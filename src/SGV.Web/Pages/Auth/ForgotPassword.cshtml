@page "/auth/forgot-password"
@model SGV.Web.Pages.Auth.ForgotPasswordModel

@{
    ViewBag.title = "Recuperar contraseña";
}

<div class="auth-box overflow-hidden align-items-center d-flex">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xxl-4 col-md-6 col-sm-8">
                <div class="auth-brand text-center mb-4">
                    <a class="logo-dark" href="/">
                        <img alt="SGV" src="/images/logo-black.png" />
                    </a>
                    <h4 class="fw-bold mt-3">Recuperar contraseña</h4>
                    <p class="text-muted w-lg-75 mx-auto">
                        Ingresá tu correo electrónico y te enviaremos un enlace para restablecerla.
                    </p>
                </div>

                <div class="card p-4">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @if (Model.StatusMessage is not null)
                        {
                            <div class="alert alert-success" role="status">@Model.StatusMessage</div>
                        }

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-primary fw-semibold py-2" type="submit">Enviar enlace</button>
                        </div>
                    </form>

                    <p class="text-muted text-center mt-4 mb-0">
                        Volver a
                        <a class="text-decoration-underline link-offset-3 fw-semibold" href="/auth/sign-in">Iniciar sesión</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
