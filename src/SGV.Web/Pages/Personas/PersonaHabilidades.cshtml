@page "/personas/{id:guid}/habilidades"
@model SGV.Web.Pages.Personas.PersonaHabilidadesModel

@{
    ViewBag.title = "Habilidades de la persona";
    ViewBag.subtitle = "Personas";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (Model.ViewModel.IsRecoverable)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">No se pudieron cargar las habilidades.</h5>
                    <p class="text-muted mb-3">@Model.ViewModel.ErrorMessage</p>
                    <a class="btn btn-primary" href="/personas">
                        <i class="ti ti-arrow-left me-1"></i>Volver al listado
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else if (!Model.EsAdministrador)
{
    <div class="alert alert-danger" role="alert">
        Esta sección requiere rol Administrador.
    </div>
}
else
{
    <div class="row mb-3">
        <div class="col-12">
            <h4 class="mb-0">Habilidades de @Model.ViewModel.PersonaNombre</h4>
        </div>
    </div>

    @if (Model.ViewModel.Skills.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Esta persona no tiene habilidades asignadas.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Habilidad</th>
                                        <th>Nivel</th>
                                        <th style="width: 220px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var skill in Model.ViewModel.Skills)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@skill.SkillNombre</div>
                                                <div class="text-muted small">@skill.SkillCodigo</div>
                                            </td>
                                            <td>
                                                <form method="post" asp-page-handler="Actualizar" class="d-flex gap-2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="skillId" value="@skill.SkillId" />
                                                    <select name="NivelHabilidadId" class="form-select form-select-sm">
                                                        <option value="@skill.NivelHabilidadId" selected="selected">@skill.NivelNombre</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                                                </form>
                                            </td>
                                            <td>
                                                <form method="post" asp-page-handler="Quitar">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="skillId" value="@skill.SkillId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row mt-4">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Asignar nueva habilidad</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Asignar">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="SkillId" class="form-label">Habilidad</label>
                                <select id="SkillId" name="SkillId" class="form-select">
                                    <option value="">Seleccionar habilidad...</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="NivelHabilidadId" class="form-label">Nivel</label>
                                <select id="NivelHabilidadId" name="NivelHabilidadId" class="form-select">
                                    <option value="">Seleccionar nivel...</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Asignar habilidad</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
