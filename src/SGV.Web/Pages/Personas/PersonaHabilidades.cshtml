@page "/personas/{id:guid}/habilidades"
@model SGV.Web.Pages.Personas.PersonaHabilidadesModel

@section styles {
    <link rel="stylesheet" href="/plugins/sweetalert2/sweetalert2.min.css" />
}

@{
    ViewBag.title = "Habilidades de la persona";
    ViewBag.subtitle = "Personas";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (Model.ViewModel.IsRecoverable)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">No se pudieron cargar las habilidades.</h5>
                    <p class="text-muted mb-3">@Model.ViewModel.ErrorMessage</p>
                    <a class="btn btn-primary" href="/personas">
                        <i class="ti ti-arrow-left me-1"></i>Volver al listado
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else if (!Model.EsAdministrador)
{
    <div class="alert alert-danger" role="alert">
        Esta sección requiere rol Administrador.
    </div>
}
else
{
    <div class="row mb-3">
        <div class="col-12">
            <h4 class="mb-0">Habilidades de @Model.ViewModel.PersonaNombre</h4>
        </div>
    </div>

    @if (Model.ViewModel.Skills.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Esta persona no tiene habilidades asignadas.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Habilidad</th>
                                        <th>Nivel</th>
                                        <th style="width: 220px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var skill in Model.ViewModel.Skills)
                                    {
                                        <tr data-skill-management-row>
                                            <td>
                                                <div class="fw-semibold">@skill.SkillNombre</div>
                                                <div class="text-muted small">@skill.SkillCodigo</div>
                                            </td>
                                            <td>
                                                <form method="post" asp-page-handler="Asignar" id="skill-update-@skill.SkillId" class="d-flex gap-2" data-skill-update-form>
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="SkillId" value="@skill.SkillId" />
                                                    <select name="NivelHabilidadId" class="form-select form-select-sm" data-skill-editable disabled>
                                                        @foreach (var nivel in Model.ViewModel.NivelOptions)
                                                        {
                                                            if (nivel.Id == skill.NivelHabilidadId)
                                                            {
                                                                <option value="@nivel.Id" selected="selected">@nivel.Nombre</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@nivel.Id">@nivel.Nombre</option>
                                                            }
                                                        }
                                                    </select>
                                                </form>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" data-skill-edit-button>Editar</button>
                                                    <button type="submit" class="btn btn-sm btn-primary d-none" form="skill-update-@skill.SkillId" data-skill-save-button>Guardar</button>
                                                    <form method="post" asp-page-handler="Quitar" class="d-inline" data-skill-delete-form>
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="SkillId" value="@skill.SkillId" />
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                data-skill-delete-button
                                                                data-skill-item-name="@skill.SkillNombre">Quitar</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row mt-4">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Asignar nueva habilidad</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Asignar">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="SkillId" class="form-label">Habilidad</label>
                                <select id="SkillId" name="SkillId" class="form-select">
                                    <option value="">Seleccionar habilidad...</option>
                                    @foreach (var item in Model.ViewModel.HabilidadesDisponibles)
                                    {
                                        <option value="@item.Id">@item.Nombre</option>
                                    }
                                </select>
                                <span class="text-danger">@ViewData.ModelState["SkillId"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                            </div>
                            <div class="col-md-6">
                                <label for="NivelHabilidadId" class="form-label">Nivel</label>
                                <select id="NivelHabilidadId" name="NivelHabilidadId" class="form-select">
                                    <option value="">Seleccionar nivel...</option>
                                    @foreach (var nivel in Model.ViewModel.NivelOptions)
                                    {
                                        <option value="@nivel.Id">@nivel.Nombre</option>
                                    }
                                </select>
                                <span class="text-danger">@ViewData.ModelState["NivelHabilidadId"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Asignar habilidad</button>
                        </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section scripts {
    <script src="/plugins/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="/js/pages/skill-management.js"></script>
}
