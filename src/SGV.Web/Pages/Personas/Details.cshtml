@page "/personas/detalle/{id:guid}"
@model SGV.Web.Pages.Personas.DetailsModel
@using SGV.Contracts.Seguridad
@{
    ViewBag.title = "Detalle de persona";
    ViewBag.subtitle = "Personas";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (Model.IsNotFound)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">La persona solicitada no está disponible.</h5>
                    <p class="text-muted mb-0">Es posible que la persona haya sido eliminada o que haya ocurrido un error al consultarla.</p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-1">@Model.Persona!.Apellidos, @Model.Persona!.Nombres</h4>
                    @if (!string.IsNullOrWhiteSpace(Model.Persona!.Legajo))
                    {
                        <p class="text-muted mb-0">Legajo: @Model.Persona!.Legajo</p>
                    }
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Legajo</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Persona!.Legajo) ? "—" : Model.Persona!.Legajo)</dd>

                        <dt class="col-sm-3 text-muted">Nombres</dt>
                        <dd class="col-sm-9">@Model.Persona!.Nombres</dd>

                        <dt class="col-sm-3 text-muted">Apellidos</dt>
                        <dd class="col-sm-9">@Model.Persona!.Apellidos</dd>

                        <dt class="col-sm-3 text-muted">Email</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Persona!.Email) ? "—" : Model.Persona!.Email)</dd>

                        <dt class="col-sm-3 text-muted">Tipo de documento</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Persona!.TipoDocumentoCodigo) ? "—" : Model.Persona!.TipoDocumentoCodigo)</dd>

                        <dt class="col-sm-3 text-muted">Número de documento</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Persona!.NumeroDocumento) ? "—" : Model.Persona!.NumeroDocumento)</dd>

                        <dt class="col-sm-3 text-muted">Teléfono</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Persona!.Telefono) ? "—" : Model.Persona!.Telefono)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-3">
    <div class="col-12 d-flex gap-2">
        @if (!Model.IsNotFound)
        {
            <a class="btn btn-warning" href="@Url.Page("/Personas/Edit", new { id = Model.Persona!.Id, p = Model.CurrentPage, search = Model.Search, sort = Model.Sort, returnStatus = Model.Status })">
                <i class="ti ti-pencil me-1"></i>Editar
            </a>
            @* Slice 3b (REQ-PM-01): botón "Habilidades" sólo visible para
               personas consultables como activas + administrador. El
               subrecurso sigue protegido por [Authorize] en la Razor Page
               destino como defensa redundante (ver PersonaHabilidadesModel). *@
            @if (Model.Persona!.IsActive && User.IsInRole(RolesSgv.Administrador))
            {
                <a class="btn btn-info" href="@Url.Page("/Personas/PersonaHabilidades", new { id = Model.Persona!.Id })">
                    <i class="ti ti-stars me-1"></i>Habilidades
                </a>
            }
        }
        <a class="btn btn-outline-secondary" href="@Url.Page("/Personas/Index", new { p = Model.CurrentPage, search = Model.Search, sort = Model.Sort, status = Model.Status })">
            <i class="ti ti-arrow-left me-1"></i>Volver al listado
        </a>
    </div>
</div>