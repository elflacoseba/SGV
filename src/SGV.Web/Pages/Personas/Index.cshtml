@page "/personas"
@model SGV.Web.Pages.Personas.IndexModel

@{
    ViewBag.title = "Personas";
    ViewBag.subtitle = "Personas";
}

@section styles {
    <link rel="stylesheet" href="/plugins/sweetalert2/sweetalert2.min.css" />
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind d-flex justify-content-between align-items-center" role="alert">
        <span>@Model.StatusMessage</span>
        @* REQ-CW-06: el CTA Reactivar del banner SOLO se muestra en la vista Activas
           y SOLO si hay un LastDeletedId persistido en TempData. La propiedad
           Model.LastDeletedId se popula desde TempData en LoadAsync. *@
        @if (Model.EsAdministrador && Model.HasLastDeleted && !Model.IsDeletedView)
        {
            <form method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input name="id" type="hidden" value="@Model.LastDeletedId" />
                <input name="page" type="hidden" value="@Model.CurrentPage" />
                <input name="search" type="hidden" value="@Model.Search" />
                <input name="sort" type="hidden" value="@Model.Sort" />
                <input name="status" type="hidden" value="@Model.Segmento" />
                <button type="submit" class="btn btn-sm btn-outline-primary ms-2" formaction="?handler=Reactivate">Reactivar</button>
            </form>
        }
        @if (TempData["ErrorCode"] is string errorCode && !string.IsNullOrWhiteSpace(errorCode))
        {
            <span class="badge bg-secondary ms-2">@errorCode</span>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.LoadErrorMessage</div>
}

<div class="row">
    <div class="col-12">
        <div class="card" data-table>
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h4 class="card-title mb-1">
                        @(Model.IsDeletedView ? "Listado de personas eliminadas" : "Listado de personas activas")
                    </h4>
                    <p class="text-muted mb-0">
                        @(Model.IsDeletedView
                            ? "Visualiza y reactiva personas dadas de baja lógica."
                            : "Consulta, búsqueda y baja lógica del módulo de Personas.")
                    </p>
                </div>
                <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                    <div class="btn-group" role="group" aria-label="Filtrar por estado">
                        <a class="btn btn-sm @(Model.IsDeletedView ? "btn-light" : "btn-primary")" href="@Url.Page("/Personas/Index", Model.BuildToggleSegmentoRouteValues(null))">Activas</a>
                        <a class="btn btn-sm @(Model.IsDeletedView ? "btn-primary" : "btn-light")" href="@Url.Page("/Personas/Index", Model.BuildToggleSegmentoRouteValues("eliminadas"))">Eliminadas</a>
                    </div>
                    <span class="badge badge-soft-primary fs-xs">@Model.TotalCount registro(s)</span>
                    @if (!Model.IsDeletedView && Model.EsAdministrador)
                    {
                        <a class="btn btn-primary btn-sm" href="/personas/crear">
                            <i class="ti ti-plus me-1"></i>Crear persona
                        </a>
                    }
                </div>
            </div>
            <div class="card-header border-0">
                <form class="row g-2 align-items-center w-100" method="get">
                    <div class="col-md-6 col-xl-4">
                        <div class="app-search">
                            <input class="form-control" name="search" placeholder="Buscar..." data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Buscar por legajo, nombres, apellidos, email o documento..." type="search" value="@Model.Search" />
                            <i class="ti ti-search app-search-icon text-muted"></i>
                        </div>
                    </div>
                    <input name="sort" type="hidden" value="@Model.Sort" />
                    <input name="status" type="hidden" value="@Model.Segmento" />
                    <div class="col-auto">
                        <button class="btn btn-primary" type="submit">Buscar</button>
                    </div>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-centered table-hover w-100 mb-0">
                    <thead class="bg-light align-middle bg-opacity-25 thead-sm">
                        <tr class="text-uppercase fs-xxs">
                            @{
                                var legajoIcon = Model.GetSortIcon("legajo");
                                var apellidosIcon = Model.GetSortIcon("apellidos");
                                var nombresIcon = Model.GetSortIcon("nombres");
                                var emailIcon = Model.GetSortIcon("email");
                            }
                            <th>
                                <a class="link-reset" href="@Url.Page("/Personas/Index", new { p = Model.CurrentPage, search = Model.Search, sort = Model.GetSortRoute("legajo"), status = Model.Segmento })">
                                    Legajo
                                    @if (!string.IsNullOrEmpty(legajoIcon))
                                    {
                                        <i class="@legajoIcon ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a class="link-reset" href="@Url.Page("/Personas/Index", new { p = Model.CurrentPage, search = Model.Search, sort = Model.GetSortRoute("apellidos"), status = Model.Segmento })">
                                    Apellidos
                                    @if (!string.IsNullOrEmpty(apellidosIcon))
                                    {
                                        <i class="@apellidosIcon ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a class="link-reset" href="@Url.Page("/Personas/Index", new { p = Model.CurrentPage, search = Model.Search, sort = Model.GetSortRoute("nombres"), status = Model.Segmento })">
                                    Nombres
                                    @if (!string.IsNullOrEmpty(nombresIcon))
                                    {
                                        <i class="@nombresIcon ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a class="link-reset" href="@Url.Page("/Personas/Index", new { p = Model.CurrentPage, search = Model.Search, sort = Model.GetSortRoute("email"), status = Model.Segmento })">
                                    Email
                                    @if (!string.IsNullOrEmpty(emailIcon))
                                    {
                                        <i class="@emailIcon ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>Documento</th>
                            <th class="text-center" style="width: 1%">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td class="text-center text-muted py-4" colspan="6">
                                    @(Model.IsDeletedView ? "No se encontraron personas eliminadas." : "No se encontraron personas activas.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">@(string.IsNullOrWhiteSpace(item.Legajo) ? "—" : item.Legajo)</td>
                                    <td>
                                        <div class="fw-medium">@item.Apellidos</div>
                                    </td>
                                    <td>@item.Nombres</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Email))
                                        {
                                            <span class="text-muted">@item.Email</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.NumeroDocumento))
                                        {
                                            <span class="badge badge-soft-secondary fs-xs">@(string.IsNullOrWhiteSpace(item.TipoDocumento) ? item.NumeroDocumento : $"{item.TipoDocumento}: {item.NumeroDocumento}")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            @if (!Model.IsDeletedView)
                                            {
                                                <a class="btn btn-info btn-icon btn-sm rounded-circle" href="@Url.Page("/Personas/Details", Model.BuildDetailsRouteValues(item.Id))" data-bs-toggle="tooltip" data-bs-title="Ver detalle" aria-label="Detalle de @item.Apellidos, @item.Nombres">
                                                    <i class="ti ti-eye fs-lg"></i>
                                                </a>
                                                @if (Model.EsAdministrador)
                                                {
                                                    <a class="btn btn-primary btn-icon btn-sm rounded-circle" href="@Url.Page("/Personas/PersonaHabilidades", Model.BuildHabilidadesRouteValues(item.Id))" data-bs-toggle="tooltip" data-bs-title="Habilidades" aria-label="Gestionar habilidades de @item.Apellidos, @item.Nombres">
                                                        <i class="ti ti-stars fs-lg"></i>
                                                    </a>
                                                    <a class="btn btn-warning btn-icon btn-sm rounded-circle" href="@Url.Page("/Personas/Edit", Model.BuildEditRouteValues(item.Id))" data-bs-toggle="tooltip" data-bs-title="Editar" aria-label="Editar @item.Apellidos, @item.Nombres">
                                                        <i class="ti ti-edit fs-lg"></i>
                                                    </a>
                                                    <form data-persona-delete-form method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input name="id" type="hidden" value="@item.Id" />
                                                        <input name="page" type="hidden" value="@Model.CurrentPage" />
                                                        <input name="search" type="hidden" value="@Model.Search" />
                                                        <input name="sort" type="hidden" value="@Model.Sort" />
                                                        <input name="status" type="hidden" value="@Model.Segmento" />
                                                        <button aria-label="Eliminar @item.Apellidos, @item.Nombres" class="btn btn-danger btn-icon btn-sm rounded-circle" data-persona-delete-button data-persona-item-name="@item.Apellidos, @item.Nombres" data-persona-item-legajo="@item.Legajo" data-bs-toggle="tooltip" data-bs-title="Eliminar" formaction="?handler=Delete" type="submit">
                                                            <i class="ti ti-trash fs-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                            }
                                            else
                                            {
                                                @if (Model.EsAdministrador)
                                                {
                                                    <form data-persona-reactivate-form method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input name="id" type="hidden" value="@item.Id" />
                                                        <input name="page" type="hidden" value="@Model.CurrentPage" />
                                                        <input name="search" type="hidden" value="@Model.Search" />
                                                        <input name="sort" type="hidden" value="@Model.Sort" />
                                                        <input name="status" type="hidden" value="@Model.Segmento" />
                                                        <button aria-label="Reactivar @item.Apellidos, @item.Nombres" class="btn btn-success btn-icon btn-sm rounded-circle" data-persona-reactivate-button data-persona-item-name="@item.Apellidos, @item.Nombres" data-persona-item-legajo="@item.Legajo" data-bs-toggle="tooltip" data-bs-title="Reactivar" formaction="?handler=Reactivate" type="submit">
                                                            <i class="ti ti-refresh fs-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">
                <span class="text-muted">Página @Model.CurrentPage de @Model.TotalPages</span>
                <nav aria-label="Paginación de personas">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : null)">
                            <a class="page-link" href="@Url.Page("/Personas/Index", new { p = Model.CurrentPage - 1, search = Model.Search, sort = Model.Sort, status = Model.Segmento })">Anterior</a>
                        </li>
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : null)">
                                <a class="page-link" href="@Url.Page("/Personas/Index", new { p = pageNumber, search = Model.Search, sort = Model.Sort, status = Model.Segmento })">@pageNumber</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : null)">
                            <a class="page-link" href="@Url.Page("/Personas/Index", new { p = Model.CurrentPage + 1, search = Model.Search, sort = Model.Sort, status = Model.Segmento })">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="/plugins/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="/js/pages/personas-index.js"></script>
}