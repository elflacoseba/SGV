@* This is a field partial, not a complete form. The consumer must provide: <form>, antiforgery token, hidden return, submit/cancel actions, and loaded TiposDocumento. *@
@* Shared form partial for create/edit of Personas. *@
@* Expects a model that implements IPersonaForm. *@
@using Microsoft.AspNetCore.Mvc.Rendering
@using SGV.Contracts.Personas.Consultas.Dtos
@model SGV.Web.Integration.Personas.IPersonaForm
@{
    // Issue #202: slot reservado para que módulos downstream que exijan
    // Legajo activen una advertencia contextual sin bloquear el submit.
    // El default queda oculto y vacío; ShowLegajoContextWarning controla
    // visibilidad y LegajoContextWarningMessage permite personalizar el
    // texto (null → mensaje por defecto del shell).
    var mostrarWarning = Model.ShowLegajoContextWarning;
    var mensajeWarning = mostrarWarning
        ? (string.IsNullOrWhiteSpace(Model.LegajoContextWarningMessage)
            ? "Este legajo se utiliza en flujos que lo requieren."
            : Model.LegajoContextWarningMessage)
        : string.Empty;
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.Legajo" class="form-control" placeholder="Legajo" />
            <label asp-for="Input.Legajo">Legajo</label>
            <span asp-validation-for="Input.Legajo" class="text-danger"></span>
            @* Issue #202: span condicional para advertencia contextual. *@
            <span class="text-warning small@(mostrarWarning ? string.Empty : " hidden")" data-legajo-context-warning>@mensajeWarning</span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.Nombres" class="form-control" placeholder="Nombres" />
            <label asp-for="Input.Nombres">Nombres</label>
            <span asp-validation-for="Input.Nombres" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.Apellidos" class="form-control" placeholder="Apellidos" />
            <label asp-for="Input.Apellidos">Apellidos</label>
            <span asp-validation-for="Input.Apellidos" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.Email" class="form-control" placeholder="Email" type="email" />
            <label asp-for="Input.Email">Email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        @* Issue #147 PR3: <select> poblado desde IPersonaForm.TiposDocumento. *@
        @* Materializamos la SelectList acá para mantener el binding por nombre de campo simple. *@
        @{
            // Texto = Codigo (DNI/LE/LC/Pasaporte) según spec persona-management
            // § "Formulario Create carga TiposDocumento": las etiquetas
            // visibles tienen que ser las códigos canónicos, no los nombres
            // descriptivos.
            var tiposOptions = new SelectList(Model.TiposDocumento, nameof(TipoDocumentoDto.Id), nameof(TipoDocumentoDto.Codigo));
        }
        <div class="form-floating">
            <select asp-for="Input.TipoDocumentoId" class="form-select" asp-items="tiposOptions">
                <option value="">Seleccionar tipo…</option>
            </select>
            <label asp-for="Input.TipoDocumentoId">Tipo de documento</label>
            <span asp-validation-for="Input.TipoDocumentoId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.NumeroDocumento" class="form-control" placeholder="Número de documento" />
            <label asp-for="Input.NumeroDocumento">Número de documento</label>
            <span asp-validation-for="Input.NumeroDocumento" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.Telefono" class="form-control" placeholder="Teléfono" />
            <label asp-for="Input.Telefono">Teléfono</label>
            <span asp-validation-for="Input.Telefono" class="text-danger"></span>
        </div>
    </div>
</div>
