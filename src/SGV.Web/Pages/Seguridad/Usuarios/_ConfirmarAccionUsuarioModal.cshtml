@* Partial compartido para modales de confirmación de acciones sobre
   usuarios (Bloquear / Desbloquear). Emite markup genérico de Bootstrap
   5 (REQ-UCB-05 AA) y delega el data-attribute del botón Confirmar al
   consumidor vía ViewData — así el mismo partial sirve para
   `data-usuario-bloquear-confirm` y `data-usuario-desbloquear-confirm`.

   Contrato (todos vía ViewDataDictionary):
   - ModalId (string, required): id del modal (e.g., "confirm-bloquear-modal").
   - TitleId (string, opcional; default = ModalId + "-title"): id del <h5> del título.
   - Title (string, required): texto del título (e.g., "Bloquear usuario").
   - BodyHtml (IHtmlContent, opcional; default = "este usuario"): cuerpo.
   - ConfirmButtonClass (string, required): clase CSS del botón Confirmar
     (e.g., "btn-secondary" para Bloquear, "btn-success" para Desbloquear).
   - ConfirmButtonText (string, opcional; default = ConfirmAriaLabel o Title):
     texto del botón Confirmar.
   - ConfirmAriaLabel (string, opcional; default = ConfirmButtonText): aria-label.
   - ConfirmSelector (string, required): sufijo del data-attribute del botón
     Confirmar. Se emite como `data-@ConfirmSelector`. Para
     `data-usuario-bloquear-confirm` pasar `usuario-bloquear-confirm`.
   - PendingTriggerVar (string, required): nombre lógico de la variable global
     donde el JS almacena el form diferido. El partial NO emite JS — sólo
     documenta el contrato para que el `@section Scripts` del view lo use.
*@

@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{
    var modalId = ViewData["ModalId"] as string
        ?? throw new InvalidOperationException("_ConfirmarAccionUsuarioModal: ViewData['ModalId'] es requerido.");
    var titleId = ViewData["TitleId"] as string ?? $"{modalId}-title";
    var title = ViewData["Title"] as string
        ?? throw new InvalidOperationException("_ConfirmarAccionUsuarioModal: ViewData['Title'] es requerido.");
    var bodyHtml = ViewData["BodyHtml"] as IHtmlContent;
    var confirmButtonClass = ViewData["ConfirmButtonClass"] as string
        ?? throw new InvalidOperationException("_ConfirmarAccionUsuarioModal: ViewData['ConfirmButtonClass'] es requerido.");
    var confirmAriaLabel = ViewData["ConfirmAriaLabel"] as string;
    var confirmButtonText = ViewData["ConfirmButtonText"] as string
        ?? confirmAriaLabel
        ?? title;
    confirmAriaLabel ??= confirmButtonText;
    var confirmSelector = ViewData["ConfirmSelector"] as string
        ?? throw new InvalidOperationException("_ConfirmarAccionUsuarioModal: ViewData['ConfirmSelector'] es requerido (e.g., 'usuario-bloquear-confirm').");
    var pendingTriggerVar = ViewData["PendingTriggerVar"] as string
        ?? throw new InvalidOperationException("_ConfirmarAccionUsuarioModal: ViewData['PendingTriggerVar'] es requerido.");
    // pendingTriggerVar queda en el contrato como comentario visible para
    // el @section Scripts del view (D-04: dos globals separadas, una por acción).
}

<div class="modal fade" id="@modalId" tabindex="-1"
     aria-labelledby="@titleId" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@titleId">@title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @* REQ-UCB-04: el cuerpo del modal NUNCA expone UserName /
                   Email / Nombres / Apellidos del usuario objetivo; la
                   confirmación se reduce a "este usuario". El consumidor
                   puede sobreescribir este bloque vía BodyHtml si la
                   acción necesita más contexto (manteniendo el contrato
                   de no incluir PII). *@
                @if (bodyHtml is not null)
                {
                    @bodyHtml
                }
                else
                {
                    <p class="mb-0">
                        Esta acción afecta <strong>este usuario</strong>. ¿Desea continuar?
                    </p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn @confirmButtonClass"
                        data-@confirmSelector
                        aria-label="@confirmAriaLabel">@confirmButtonText</button>
            </div>
        </div>
    </div>
</div>