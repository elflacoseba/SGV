@page "/seguridad/usuarios"
@model SGV.Web.Pages.Seguridad.Usuarios.IndexModel

@{
    ViewBag.title = "Usuarios";
    ViewBag.subtitle = "Seguridad";
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind d-flex justify-content-between align-items-center" role="alert">
        <span>@Model.StatusMessage</span>
        @if (TempData["ErrorCode"] is string errorCode && !string.IsNullOrWhiteSpace(errorCode))
        {
            <span class="badge bg-secondary ms-2">@errorCode</span>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.LoadErrorMessage</div>
}

<div class="row">
    <div class="col-12">
        <div class="card" data-table>
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h4 class="card-title mb-1">
                        @(Model.IsBlockedView ? "Listado de usuarios bloqueados" : "Listado de usuarios activos")
                    </h4>
                    <p class="text-muted mb-0">
                        @(Model.IsBlockedView
                            ? "Visualiza y desbloquea cuentas con lockout administrativo."
                            : "Consulta y administra las cuentas vinculadas a Personas.")
                    </p>
                </div>
                <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                    <div class="btn-group" role="group" aria-label="Filtrar por estado">
                        <a class="btn btn-sm @(Model.IsBlockedView ? "btn-light" : "btn-primary")"
                           href="@Url.Page("/Seguridad/Usuarios/Index", Model.BuildToggleSegmentoRouteValues("activas"))">Activos</a>
                        <a class="btn btn-sm @(Model.IsBlockedView ? "btn-primary" : "btn-light")"
                           href="@Url.Page("/Seguridad/Usuarios/Index", Model.BuildToggleSegmentoRouteValues("bloqueadas"))">Bloqueados</a>
                    </div>
                    <span class="badge badge-soft-primary fs-xs">@Model.TotalCount registro(s)</span>
                    @if (!Model.IsBlockedView && Model.EsAdministrador)
                    {
                        <a class="btn btn-primary btn-sm" href="/seguridad/usuarios/crear">
                            <i class="ti ti-plus me-1"></i>Crear usuario
                        </a>
                    }
                </div>
            </div>

            <div class="card-header border-0">
                <form class="row g-2 align-items-center w-100" method="get">
                    <div class="col-md-6 col-xl-4">
                        <div class="app-search">
                            <input class="form-control" name="search" placeholder="Buscar..." type="search" value="@Model.Search"
                                   data-bs-toggle="tooltip" data-bs-placement="top"
                                   data-bs-title="Buscar por usuario, email, nombres o apellidos..." />
                            <i class="ti ti-search app-search-icon text-muted"></i>
                        </div>
                    </div>
                    <input name="sort" type="hidden" value="@Model.Sort" />
                    <input name="status" type="hidden" value="@Model.Segmento" />
                    <div class="col-auto">
                        <button class="btn btn-primary" type="submit">Buscar</button>
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-custom table-centered table-hover w-100 mb-0">
                    <thead class="bg-light align-middle bg-opacity-25 thead-sm">
                        <tr class="text-uppercase fs-xxs">
                            @{
                                var userNameIcon = Model.GetSortIcon("username");
                                var emailIcon = Model.GetSortIcon("email");
                                var nombresIcon = Model.GetSortIcon("nombres");
                                var apellidosIcon = Model.GetSortIcon("apellidos");
                            }
                            <th>
                                <a class="link-reset" href="@Url.Page("/Seguridad/Usuarios/Index", new { p = Model.CurrentPage, search = Model.Search, sort = Model.GetSortRoute("username"), status = Model.Segmento })">
                                    Usuario
                                    @if (!string.IsNullOrEmpty(userNameIcon))
                                    {
                                        <i class="@userNameIcon ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a class="link-reset" href="@Url.Page("/Seguridad/Usuarios/Index", new { p = Model.CurrentPage, search = Model.Search, sort = Model.GetSortRoute("email"), status = Model.Segmento })">
                                    Email
                                    @if (!string.IsNullOrEmpty(emailIcon))
                                    {
                                        <i class="@emailIcon ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a class="link-reset" href="@Url.Page("/Seguridad/Usuarios/Index", new { p = Model.CurrentPage, search = Model.Search, sort = Model.GetSortRoute("nombres"), status = Model.Segmento })">
                                    Nombres
                                    @if (!string.IsNullOrEmpty(nombresIcon))
                                    {
                                        <i class="@nombresIcon ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a class="link-reset" href="@Url.Page("/Seguridad/Usuarios/Index", new { p = Model.CurrentPage, search = Model.Search, sort = Model.GetSortRoute("apellidos"), status = Model.Segmento })">
                                    Apellidos
                                    @if (!string.IsNullOrEmpty(apellidosIcon))
                                    {
                                        <i class="@apellidosIcon ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>Roles</th>
                            <th class="text-center" style="width: 1%">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td class="text-center text-muted py-4" colspan="6">
                                    @(Model.IsBlockedView
                                        ? "No se encontraron usuarios bloqueados."
                                        : "No se encontraron usuarios activos.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                var esAuto = Model.EsAutoAccion(item.Id);
                                <tr>
                                    <td class="fw-semibold">@item.UserName</td>
                                    <td>@item.Email</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Nombres) ? "—" : item.Nombres)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Apellidos) ? "—" : item.Apellidos)</td>
                                    <td>
                                        @if (item.Roles.Count == 0)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            foreach (var role in item.Roles)
                                            {
                                                <span class="badge badge-soft-secondary fs-xs me-1">@role</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            @if (!Model.IsBlockedView)
                                            {
                                                <a class="btn btn-info btn-icon btn-sm rounded-circle" href="@Model.BuildDetailsUrl(item.Id)"
                                                   data-bs-toggle="tooltip" data-bs-title="Ver detalle" aria-label="Detalle de @item.UserName">
                                                    <i class="ti ti-eye fs-lg"></i>
                                                </a>
                                                @if (Model.EsAdministrador)
                                                {
                                                    <a class="btn btn-warning btn-icon btn-sm rounded-circle" href="@Model.BuildEditUrl(item.Id)"
                                                       data-bs-toggle="tooltip" data-bs-title="Editar" aria-label="Editar @item.UserName">
                                                        <i class="ti ti-edit fs-lg"></i>
                                                    </a>
                                                    if (!esAuto)
                                                    {
                                                        <form data-usuario-bloquear-form method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input name="id" type="hidden" value="@item.Id" />
                                                            <input name="page" type="hidden" value="@Model.CurrentPage" />
                                                            <input name="search" type="hidden" value="@Model.Search" />
                                                            <input name="sort" type="hidden" value="@Model.Sort" />
                                                            <input name="status" type="hidden" value="@Model.Segmento" />
                                                            <button aria-label="Bloquear a @item.UserName" class="btn btn-secondary btn-icon btn-sm rounded-circle"
                                                                    data-usuario-bloquear-button
                                                                    data-bs-toggle="tooltip" data-bs-title="Bloquear" formaction="?handler=Bloquear" type="submit">
                                                                <i class="ti ti-lock fs-lg"></i>
                                                            </button>
                                                        </form>
                                                        <form data-usuario-delete-form method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input name="id" type="hidden" value="@item.Id" />
                                                            <input name="page" type="hidden" value="@Model.CurrentPage" />
                                                            <input name="search" type="hidden" value="@Model.Search" />
                                                            <input name="sort" type="hidden" value="@Model.Sort" />
                                                            <input name="status" type="hidden" value="@Model.Segmento" />
                                                            <button aria-label="Eliminar a @item.UserName" class="btn btn-danger btn-icon btn-sm rounded-circle"
                                                                    data-usuario-delete-button
                                                                    data-bs-toggle="modal" data-bs-target="#confirm-delete-modal"
                                                                    formaction="?handler=Delete" type="submit">
                                                                <i class="ti ti-trash fs-lg"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                }
                                            }
                                            else if (Model.EsAdministrador)
                                            {
                                                <form data-usuario-desbloquear-form method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input name="id" type="hidden" value="@item.Id" />
                                                    <input name="page" type="hidden" value="@Model.CurrentPage" />
                                                    <input name="search" type="hidden" value="@Model.Search" />
                                                    <input name="sort" type="hidden" value="@Model.Sort" />
                                                    <input name="status" type="hidden" value="@Model.Segmento" />
                                                    <button aria-label="Desbloquear a @item.UserName" class="btn btn-success btn-icon btn-sm rounded-circle"
                                                            data-usuario-desbloquear-button
                                                            data-bs-toggle="tooltip" data-bs-title="Desbloquear" formaction="?handler=Desbloquear" type="submit">
                                                        <i class="ti ti-lock-open fs-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">
                <span class="text-muted">Página @Model.CurrentPage de @Model.TotalPages</span>
                <nav aria-label="Paginación de usuarios">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : null)">
                            <a class="page-link" href="@Url.Page("/Seguridad/Usuarios/Index", new { p = Model.CurrentPage - 1, search = Model.Search, sort = Model.Sort, status = Model.Segmento })">Anterior</a>
                        </li>
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : null)">
                                <a class="page-link" href="@Url.Page("/Seguridad/Usuarios/Index", new { p = pageNumber, search = Model.Search, sort = Model.Sort, status = Model.Segmento })">@pageNumber</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : null)">
                            <a class="page-link" href="@Url.Page("/Seguridad/Usuarios/Index", new { p = Model.CurrentPage + 1, search = Model.Search, sort = Model.Sort, status = Model.Segmento })">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@* Modal irreversible de confirmación de eliminación. Phase 3: NO muestra
   el nombre de usuario (ni UserName ni nombres/apellidos) para no
   exponer PII al usuario que está a punto de confirmar un borrado
   físico. La decisión se reduce a "este usuario" — el admin confirma
   que conoce el impacto y avanza. *@
<div class="modal fade" id="confirm-delete-modal" tabindex="-1" aria-labelledby="confirm-delete-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirm-delete-modal-title">Eliminar usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">
                    Esta acción eliminará <strong>este usuario</strong> de forma permanente. No se puede deshacer.
                </p>
                <p class="text-muted small mb-0">
                    La persona vinculada y las auditorías previas se conservan.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-usuario-delete-confirm>Eliminar definitivamente</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var confirmButton = document.querySelector('[data-usuario-delete-confirm]');
        if (!confirmButton) return;
        confirmButton.addEventListener('click', function () {
            var trigger = window.__pendingDeleteTrigger;
            if (!trigger) return;
            trigger.submit();
            window.__pendingDeleteTrigger = null;
        });
        document.querySelectorAll('[data-usuario-delete-button]').forEach(function (btn) {
            btn.addEventListener('click', function (event) {
                event.preventDefault();
                window.__pendingDeleteTrigger = btn.closest('form');
            });
        });
    })();
</script>
}
