@page "/seguridad/usuarios/detalle/{id}"
@using SGV.Contracts.Personas.Consultas.Dtos
@model SGV.Web.Pages.Seguridad.Usuarios.DetailsModel

@{
    ViewBag.title = "Detalle de usuario";
    ViewBag.subtitle = "Seguridad";
}

@section styles {
    <link rel="stylesheet" href="/plugins/sweetalert2/sweetalert2.min.css" />
}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml")

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusKind" role="alert">@Model.StatusMessage</div>
}

@if (Model.IsNotFound)
{
    @* Estado recuperable: el backend respondió 404 (o un error de
       transporte recuperable). El admin ve un mensaje claro y un link
       de vuelta al listado — NO es un error duro. *@
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-alert-circle fs-2x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">El usuario solicitado no está disponible.</h5>
                    <p class="text-muted mb-3">
                        Es posible que la cuenta haya sido eliminada o que el servicio no haya podido responder.
                    </p>
                    <a class="btn btn-outline-secondary" href="@Model.BuildIndexUrl()">
                        <i class="ti ti-arrow-left me-1"></i>Volver al listado
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-1">@Model.Usuario!.UserName</h4>
                    <p class="text-muted mb-0">@Model.Usuario.Email</p>
                </div>
                @if (Model.IsCuentaBloqueada)
                {
                    @* Phase 3: banner visible cuando Bloqueado=true. La
                       fuente de verdad es el DTO; el returnStatus es sólo
                       un hint y NO bloquea el render del banner. *@
                    <div class="alert alert-warning rounded-0 mb-0 d-flex align-items-center" role="alert">
                        <i class="ti ti-lock me-2 fs-lg"></i>
                        <span>
                            <strong>Cuenta bloqueada.</strong>
                            Este usuario no puede iniciar sesión hasta que sea desbloqueado.
                        </span>
                    </div>
                }
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Usuario</dt>
                        <dd class="col-sm-9">@Model.Usuario.UserName</dd>

                        <dt class="col-sm-3 text-muted">Email</dt>
                        <dd class="col-sm-9">@Model.Usuario.Email</dd>

                        <dt class="col-sm-3 text-muted">Nombres</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Usuario.Nombres) ? "—" : Model.Usuario.Nombres)</dd>

                        <dt class="col-sm-3 text-muted">Apellidos</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Usuario.Apellidos) ? "—" : Model.Usuario.Apellidos)</dd>

                        <dt class="col-sm-3 text-muted">Persona vinculada</dt>
                        <dd class="col-sm-9">
                            @* Card enriquecida read-only espejo de la card
                               preseleccionada de Edit (PR #168). Se replica
                               el árbol DOM de _Form.cshtml sin los botones
                               Quitar/Cambiar ni el modal — Details es
                               estrictamente read-only. El <a> hacia el
                               detalle de Persona se preserva como título
                               en ambas ramas. *@
                            @if (Model.PersonaVinculada is not null)
                            {
                                var persona = Model.PersonaVinculada;
                                var documento = FormatDocumento(persona);
                                <div class="card border mb-0" data-usuario-persona-card>
                                    <div class="card-body">
                                        <h6 class="card-title mb-3" data-usuario-persona-display-text>
                                            <a href="/personas/detalle/@Model.Usuario.PersonaId">@persona.Apellidos, @persona.Nombres</a>
                                        </h6>
                                        <dl class="row mb-0">
                                            @if (!string.IsNullOrWhiteSpace(persona.Legajo))
                                            {
                                                <dt class="col-sm-3 text-muted">Legajo</dt>
                                                <dd class="col-sm-9">@persona.Legajo</dd>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(documento))
                                            {
                                                <dt class="col-sm-3 text-muted">Documento</dt>
                                                <dd class="col-sm-9">@documento</dd>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(persona.Email))
                                            {
                                                <dt class="col-sm-3 text-muted">Email</dt>
                                                <dd class="col-sm-9">
                                                    <a href="mailto:@persona.Email">@persona.Email</a>
                                                </dd>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(persona.Telefono))
                                            {
                                                <dt class="col-sm-3 text-muted">Teléfono</dt>
                                                <dd class="col-sm-9">@persona.Telefono</dd>
                                            }
                                            <dt class="col-sm-3 text-muted">Estado</dt>
                                            <dd class="col-sm-9">
                                                @if (persona.IsActive)
                                                {
                                                    <span class="badge badge-soft-success">Activa</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-soft-secondary">Inactiva</span>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @* Fallback: 404 del API o error de transporte.
                                   Mantiene el display plano "Apellidos,
                                   Nombres" derivado del UsuarioDto, con el
                                   link al detalle de Persona preservado. *@
                                <div class="card-body py-2" data-usuario-details-persona>
                                    <a href="/personas/detalle/@Model.Usuario.PersonaId">@Model.PersonaDisplay</a>
                                </div>
                            }
                        </dd>

                        <dt class="col-sm-3 text-muted">Roles</dt>
                        <dd class="col-sm-9">
                            @if (Model.Usuario.Roles.Count == 0)
                            {
                                <span>—</span>
                            }
                            else
                            {
                                foreach (var role in Model.Usuario.Roles)
                                {
                                    <span class="badge badge-soft-secondary me-1">@role</span>
                                }
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12 d-flex flex-wrap gap-2">
            @if (Model.EsAdministrador)
            {
                var esAuto = Model.EsAutoAccion(Model.Usuario!.Id);
                @if (Model.IsCuentaBloqueada)
                {
                    @* Estado bloqueado: sólo Desbloquear (no Edit, no Eliminar). *@
                    <form data-usuario-desbloquear-form method="post" action="/seguridad/usuarios?handler=Desbloquear">
                        @Html.AntiForgeryToken()
                        <input name="id" type="hidden" value="@Model.Usuario.Id" />
                        <input name="page" type="hidden" value="@Model.CurrentPage" />
                        <input name="search" type="hidden" value="@Model.Search" />
                        <input name="sort" type="hidden" value="@Model.Sort" />
                        <input name="status" type="hidden" value="@Model.Segmento" />
                        <button class="btn btn-success"
                                data-usuario-desbloquear-button type="submit">
                            <i class="ti ti-lock-open me-1"></i>Desbloquear
                        </button>
                    </form>
                }
                else if (!esAuto)
                {
                    @* Estado activo + no auto: Edit + Bloquear + Eliminar. *@
                    <a class="btn btn-warning" href="@Model.BuildEditUrl(Model.Usuario.Id)">
                        <i class="ti ti-pencil me-1"></i>Editar
                    </a>
                    <form data-usuario-bloquear-form method="post" action="/seguridad/usuarios?handler=Bloquear">
                        @Html.AntiForgeryToken()
                        <input name="id" type="hidden" value="@Model.Usuario.Id" />
                        <input name="page" type="hidden" value="@Model.CurrentPage" />
                        <input name="search" type="hidden" value="@Model.Search" />
                        <input name="sort" type="hidden" value="@Model.Sort" />
                        <input name="status" type="hidden" value="@Model.Segmento" />
                        <button class="btn btn-secondary"
                                data-usuario-bloquear-button type="submit">
                            <i class="ti ti-lock me-1"></i>Bloquear
                        </button>
                    </form>
                    <form data-usuario-delete-form method="post" action="/seguridad/usuarios?handler=Delete">
                        @Html.AntiForgeryToken()
                        <input name="id" type="hidden" value="@Model.Usuario.Id" />
                        <input name="page" type="hidden" value="@Model.CurrentPage" />
                        <input name="search" type="hidden" value="@Model.Search" />
                        <input name="sort" type="hidden" value="@Model.Sort" />
                        <input name="status" type="hidden" value="@Model.Segmento" />
                        <button class="btn btn-danger" data-usuario-delete-button type="submit">
                            <i class="ti ti-trash me-1"></i>Eliminar
                        </button>
                    </form>
                }
                else
                {
                    @* Estado activo pero target es self: ocultar Bloquear y
                       Eliminar; mantener Edit por si quiere revisar sus
                       propios datos sin acciones destructivas. *@
                    <a class="btn btn-warning" href="@Model.BuildEditUrl(Model.Usuario.Id)">
                        <i class="ti ti-pencil me-1"></i>Editar
                    </a>
                }
            }
            <a class="btn btn-outline-secondary" href="@Model.BuildIndexUrl()">
                <i class="ti ti-arrow-left me-1"></i>Volver al listado
            </a>
        </div>
    </div>
}

@* PR 2 — Modales de confirmación migrados a SweetAlert2
   (wwwroot/js/pages/usuarios-index.js). El helper wireUsuarioActions
   es idempotente sobre los selectores: si Details sólo renderiza
   Bloquear (caso activo) o Desbloquear (caso bloqueado), las funciones
   no registradas hacen early return. El botón Eliminar (que también
   vive en Details para el caso activo + no auto) usa el mismo data
   attribute data-usuario-delete-button que Index. *@

@section scripts {
    <script src="/plugins/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="/js/pages/usuarios-index.js"></script>
}

@functions {
    /// <summary>
    /// Compone la etiqueta de Documento: <c>TipoDocumento NumeroDocumento</c>
    /// o sólo uno de los dos cuando sólo uno está presente. Espejo de
    /// <c>_Form.cshtml</c> L198-226 — misma regla para mantener paridad
    /// visual entre la card preseleccionada de Edit y la card enriquecida
    /// read-only de Details.
    /// </summary>
    private static string FormatDocumento(PersonaDto? persona)
    {
        if (persona is null)
        {
            return string.Empty;
        }

        var tipo = persona.TipoDocumento;
        var numero = persona.NumeroDocumento;
        var sinTipo = string.IsNullOrWhiteSpace(tipo);
        var sinNumero = string.IsNullOrWhiteSpace(numero);

        if (sinTipo && sinNumero)
        {
            return string.Empty;
        }

        if (sinTipo)
        {
            return numero!;
        }

        if (sinNumero)
        {
            return tipo!;
        }

        return $"{tipo} {numero}";
    }
}
