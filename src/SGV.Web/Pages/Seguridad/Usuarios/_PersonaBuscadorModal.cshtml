@* Selector modal reutilizable de Personas para Create/Edit Usuario.
   Contrato ViewData: ModalId, HiddenInputName, HiddenInputId y
   DisplayContainerId son requeridos; CurrentPersonaId y
   CurrentPersonaDisplay son opcionales. *@
@{
    var modalId = ViewData["ModalId"] as string
        ?? throw new InvalidOperationException("_PersonaBuscadorModal: ViewData['ModalId'] es requerido.");
    var hiddenInputName = ViewData["HiddenInputName"] as string
        ?? throw new InvalidOperationException("_PersonaBuscadorModal: ViewData['HiddenInputName'] es requerido.");
    var hiddenInputId = ViewData["HiddenInputId"] as string
        ?? throw new InvalidOperationException("_PersonaBuscadorModal: ViewData['HiddenInputId'] es requerido.");
    var displayContainerId = ViewData["DisplayContainerId"] as string
        ?? throw new InvalidOperationException("_PersonaBuscadorModal: ViewData['DisplayContainerId'] es requerido.");
    var currentPersonaId = ViewData["CurrentPersonaId"] is Guid personaId ? personaId : (Guid?)null;
    var currentPersonaDisplay = ViewData["CurrentPersonaDisplay"] as string;
    var titleId = $"{modalId}-label";
}

<div class="modal fade" id="@modalId" tabindex="-1" role="dialog"
     aria-modal="true" aria-labelledby="@titleId" aria-hidden="true"
     data-usuario-persona-modal
     data-api-url="/api/v1/personas/consulta"
     data-hidden-input-name="@hiddenInputName"
     data-hidden-input-id="@hiddenInputId"
     data-display-container-id="@displayContainerId"
     data-current-persona-id="@currentPersonaId"
     data-current-persona-display="@currentPersonaDisplay">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@titleId">Buscar Persona</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 align-items-center mb-3">
                    <div class="col">
                        <input type="search" class="form-control"
                               data-usuario-persona-search
                               placeholder="Buscar por legajo, nombre, apellido, email o documento"
                               autocomplete="off" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-primary" data-usuario-persona-search-button>
                            <i class="ti ti-search me-1"></i>Buscar
                        </button>
                    </div>
                </div>

                <div aria-live="polite" data-usuario-persona-status>
                    <div id="estado-inicial" class="text-center text-muted py-4"
                         data-usuario-persona-estado-inicial>
                        Ingresá un texto para buscar personas.
                    </div>
                    <div id="estado-empty" class="text-center text-muted py-4" hidden
                         data-usuario-persona-estado-empty>
                        No se encontraron personas con ese criterio.
                    </div>
                    <div id="estado-loading" class="text-center text-muted py-4" hidden
                         data-usuario-persona-estado-loading>
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        Buscando personas...
                    </div>
                    <div id="estado-error" class="alert alert-danger mb-0" role="alert" hidden
                         data-usuario-persona-estado-error>
                        No se pudo conectar con el servidor. Reintentá.
                    </div>
                </div>

                <div data-usuario-persona-results hidden aria-live="polite">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Apellido y Nombre</th>
                                    <th scope="col">Documento</th>
                                    <th scope="col">Legajo</th>
                                    <th scope="col">Email</th>
                                    <th scope="col" class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody data-usuario-persona-rows></tbody>
                        </table>
                    </div>
                    <nav class="mt-3" aria-label="Paginación de personas">
                        <ul class="pagination pagination-sm justify-content-end mb-0"
                            data-usuario-persona-pagination>
                            <li class="page-item" data-usuario-persona-previous>
                                <button type="button" class="page-link" aria-label="Página anterior">Anterior</button>
                            </li>
                            <li class="page-item" data-usuario-persona-next>
                                <button type="button" class="page-link" aria-label="Página siguiente">Siguiente</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
