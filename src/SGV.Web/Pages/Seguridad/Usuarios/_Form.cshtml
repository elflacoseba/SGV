@* This is a field partial, not a complete form. The consumer must provide: <form>, antiforgery token, hidden return, submit/cancel actions. *@
@* Shared form partial for create/edit of Usuarios. *@
@* Expects a model that implements IUsuarioForm. *@
@model SGV.Web.Integration.Usuarios.IUsuarioForm

@{
    // Slice 2 / PR 2: la card de persona (preseleccionada o vacía) la
    // emite la partial unificada `_PersonaCard.cshtml` (issue #219,
    // change `reusable-persona-card`). Se pasa FallbackDisplay con el
    // texto plano `PersonaDisplay` para que cuando el fetch del API de
    // Personas devuelva 404/transporte pero el UsuarioDto sí tenga
    // PersonaId asignado, la card muestre el texto + Quitar/Cambiar
    // (rama "editable + DTO null + FallbackDisplay"). El hidden
    // `Input.PersonaId` lo emite el consumer; el partial sincroniza el
    // `data-usuario-persona-display-input` que el JS lee/escribe.
    var tienePersona = Model.Input.PersonaId.HasValue;
    var fallbackDisplay = tienePersona ? Model.PersonaDisplay : null;
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    @* Selector compartido por Create/Edit. El id sigue siendo el contrato
       bindeable; PersonaDisplay sólo conserva la presentación de la card.
       En Edit, cuando el API trae los datos personales completos (DTO
       PersonaDto), se renderiza una card enriquecida con Legajo, Documento,
       Email y Teléfono; si el fetch falla o devolvió 404, cae al fallback
       plano con el texto derivado del UsuarioDto; si no hay PersonaId
       asignado, queda el empty state con Buscar Persona. *@
    <div class="col-12">
        <label class="form-label" for="Input_PersonaId">Persona vinculada</label>
        <input type="hidden" asp-for="Input.PersonaId" />
        @await Html.PartialAsync(
            "~/Pages/Shared/Partials/_PersonaCard.cshtml",
            Model.PersonaVinculada,
            new ViewDataDictionary(ViewData)
            {
                ["Mode"] = "editable",
                ["ShowStatusBadge"] = true,
                ["ShowQuitarCambiar"] = true,
                ["ModalId"] = "usuario-persona-buscador-modal",
                ["DisplayContainerId"] = "usuario-persona-display",
                ["PersonaIdInputName"] = "Input.PersonaId",
                ["FallbackDisplay"] = fallbackDisplay
            })
        <span asp-validation-for="Input.PersonaId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.UserName" class="form-control" placeholder="Nombre de usuario" autocomplete="off"
                   disabled="@(Model.EsAccionSobreSiMismo ? "disabled" : null)" />
            <label asp-for="Input.UserName">Nombre de usuario</label>
            <span asp-validation-for="Input.UserName" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.Email" class="form-control" placeholder="Email" type="email" autocomplete="off"
                   disabled="@(Model.EsAccionSobreSiMismo ? "disabled" : null)" />
            <label asp-for="Input.Email">Email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
    </div>

    @* Password input ONLY en Create. El cambio de password queda fuera
       del scope del change (ver spec/usuario-web-crear-editar §Out of
       scope). *@
    @if (!Model.IsEdit)
    {
        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control" placeholder="Contraseña inicial"
                       type="password" autocomplete="new-password" />
                <label asp-for="Input.Password">Contraseña inicial</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        </div>
    }

    @* Auto-edición prohibida: cuando el admin edita su propio usuario,
       los campos editables se muestran deshabilitados y un alert explica
       el motivo. El backend rechaza la edición como segunda capa de defensa
       (AutoEdicionSelf). *@
    @if (Model.EsAccionSobreSiMismo)
    {
        <div class="col-12">
            <div class="alert alert-warning d-flex align-items-center" role="alert"
                 data-usuario-self-rol-alert>
                <i class="ti ti-shield-lock me-2 fs-lg"></i>
                <span>No podés modificar tu propio usuario desde esta pantalla. Pedí a otro administrador que lo ajuste.</span>
            </div>
        </div>
    }

    <div class="col-12" data-usuario-roles-section>
        <label class="form-label">Roles</label>
        @if (Model.RenderSingleRoleSelect)
        {
            @* Issue #170 / REQ-UCE-11: alta exige asignación 1:1 usuario↔rol.
               Select único con placeholder obligatorio; binder materializa
               string[] de 1 elemento. Auto-edición desactiva el control.
               NOTA: usamos name="Input.Roles" + id="Input_Roles" en vez de
               asp-for="Input.Roles" porque el tag helper, al detectar
               string[], agrega multiple="multiple" automáticamente y eso
               muestra todas las opciones a la vez. data-choices="" delega
               el render del dropdown a Choices.js (cargado vía
               /js/pages/form-choice.js desde Create.cshtml) para que se vea
               como dropdown colapsado estetizado Inspinia. *@
            <select name="Input.Roles" id="Input_Roles" class="form-control" data-choices=""
                    disabled="@(Model.EsAccionSobreSiMismo ? "disabled" : null)">
                <option value="">-- Seleccione un rol --</option>
                @foreach (var rol in Model.Input.RolesCatalogo)
                {
                    var isSelected = Model.Input.Roles is not null
                        && Model.Input.Roles.Any(r => string.Equals(r, rol, StringComparison.Ordinal));
                    <option value="@rol" selected="@isSelected">@rol</option>
                }
            </select>
        }
        else
        {
            @* Edición: checkboxes multi-rol vigentes (contrato ActualizarUsuarioRequest.Roles). *@
            <div class="d-flex flex-wrap gap-3">
                @foreach (var rol in Model.Input.RolesCatalogo)
                {
                    var isChecked = Model.Input.Roles is not null
                        && Model.Input.Roles.Any(r => string.Equals(r, rol, StringComparison.Ordinal));
                    <div class="form-check">
                        <input type="checkbox" name="Input.Roles" value="@rol"
                               class="form-check-input" id="Input_Roles_@rol"
                               checked="@isChecked"
                               disabled="@(Model.EsAccionSobreSiMismo ? "disabled" : null)" />
                        <label class="form-check-label" for="Input_Roles_@rol">@rol</label>
                    </div>
                }
            </div>
        }
        <span asp-validation-for="Input.Roles" class="text-danger"></span>
    </div>
</div>

@await Html.PartialAsync("_PersonaBuscadorModal", null, new ViewDataDictionary(ViewData)
{
    ["ModalId"] = "usuario-persona-buscador-modal",
    ["HiddenInputName"] = "Input.PersonaId",
    ["HiddenInputId"] = "Input_PersonaId",
    ["DisplayContainerId"] = "usuario-persona-display",
    ["CurrentPersonaId"] = Model.Input.PersonaId,
    ["CurrentPersonaDisplay"] = Model.PersonaDisplay
})