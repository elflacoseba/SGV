@* This is a field partial, not a complete form. The consumer must provide: <form>, antiforgery token, hidden return, submit/cancel actions. *@
@* Shared form partial for create/edit of Usuarios. *@
@* Expects a model that implements IUsuarioForm. *@
@using SGV.Contracts.Personas.Consultas.Dtos
@model SGV.Web.Integration.Usuarios.IUsuarioForm

@{
    var personaVinculada = Model.PersonaVinculada;
    var tienePersona = Model.Input.PersonaId.HasValue;
    var documento = FormatDocumento(personaVinculada);
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    @* Selector compartido por Create/Edit. El id sigue siendo el contrato
       bindeable; PersonaDisplay sólo conserva la presentación de la card.
       En Edit, cuando el API trae los datos personales completos (DTO
       PersonaDto), se renderiza una card enriquecida con Legajo, Documento,
       Email y Teléfono; si el fetch falla o devolvió 404, cae al fallback
       plano con el texto derivado del UsuarioDto. *@
    <div class="col-12">
        <label class="form-label" for="Input_PersonaId">Persona vinculada</label>
        <input type="hidden" asp-for="Input.PersonaId" />
        <input type="hidden" name="PersonaDisplay" value="@Model.PersonaDisplay" data-usuario-persona-display-input />
        <div id="usuario-persona-display" data-usuario-persona-display>
            <div class="card border mb-0" data-usuario-persona-card
                 hidden="@(tienePersona ? null : "hidden")">
                @if (personaVinculada is not null)
                {
                    @* Card enriquecida: trae todos los campos del DTO de Persona. *@
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h6 class="card-title mb-1" data-usuario-persona-display-text>
                                    @(personaVinculada.Apellidos), @(personaVinculada.Nombres)
                                </h6>
                                @if (!string.IsNullOrWhiteSpace(personaVinculada.Legajo))
                                {
                                    <span class="text-muted small">Legajo: @personaVinculada.Legajo</span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-usuario-persona-quitar>
                                    Quitar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-usuario-persona-buscar data-bs-toggle="modal"
                                        data-bs-target="#usuario-persona-buscador-modal">
                                    Cambiar
                                </button>
                            </div>
                        </div>
                        <dl class="row mb-0">
                            @if (!string.IsNullOrWhiteSpace(documento))
                            {
                                <dt class="col-sm-3 text-muted">Documento</dt>
                                <dd class="col-sm-9">@documento</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(personaVinculada.Email))
                            {
                                <dt class="col-sm-3 text-muted">Email</dt>
                                <dd class="col-sm-9">
                                    <a href="mailto:@personaVinculada.Email">@personaVinculada.Email</a>
                                </dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(personaVinculada.Telefono))
                            {
                                <dt class="col-sm-3 text-muted">Teléfono</dt>
                                <dd class="col-sm-9">@personaVinculada.Telefono</dd>
                            }
                            <dt class="col-sm-3 text-muted">Estado</dt>
                            <dd class="col-sm-9">
                                @if (personaVinculada.IsActive)
                                {
                                    <span class="badge badge-soft-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary">Inactiva</span>
                                }
                            </dd>
                        </dl>
                    </div>
                }
                else
                {
                    @* Fallback: 404 del API o error de transporte en el
                       enriquecimiento. Mantiene el display plano vigente. *@
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-2">
                        <span data-usuario-persona-display-text>@Model.PersonaDisplay</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-usuario-persona-quitar>
                                Quitar
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-usuario-persona-buscar data-bs-toggle="modal"
                                    data-bs-target="#usuario-persona-buscador-modal">
                                Cambiar
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div data-usuario-persona-empty
                 hidden="@(tienePersona ? "hidden" : null)">
                <button type="button" class="btn btn-outline-primary"
                        data-usuario-persona-buscar data-bs-toggle="modal"
                        data-bs-target="#usuario-persona-buscador-modal">
                    <i class="ti ti-search me-1"></i>Buscar Persona
                </button>
            </div>
        </div>
        <span asp-validation-for="Input.PersonaId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.UserName" class="form-control" placeholder="Nombre de usuario" autocomplete="off"
                   disabled="@(Model.EsAccionSobreSiMismo ? "disabled" : null)" />
            <label asp-for="Input.UserName">Nombre de usuario</label>
            <span asp-validation-for="Input.UserName" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-floating">
            <input asp-for="Input.Email" class="form-control" placeholder="Email" type="email" autocomplete="off"
                   disabled="@(Model.EsAccionSobreSiMismo ? "disabled" : null)" />
            <label asp-for="Input.Email">Email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
    </div>

    @* Password input ONLY en Create. El cambio de password queda fuera
       del scope del change (ver spec/usuario-web-crear-editar §Out of
       scope). *@
    @if (!Model.IsEdit)
    {
        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control" placeholder="Contraseña inicial"
                       type="password" autocomplete="new-password" />
                <label asp-for="Input.Password">Contraseña inicial</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        </div>
    }

    @* Auto-edición prohibida: cuando el admin edita su propio usuario,
       los campos editables se muestran deshabilitados y un alert explica
       el motivo. El backend rechaza la edición como segunda capa de defensa
       (AutoEdicionSelf). *@
    @if (Model.EsAccionSobreSiMismo)
    {
        <div class="col-12">
            <div class="alert alert-warning d-flex align-items-center" role="alert"
                 data-usuario-self-rol-alert>
                <i class="ti ti-shield-lock me-2 fs-lg"></i>
                <span>No podés modificar tu propio usuario desde esta pantalla. Pedí a otro administrador que lo ajuste.</span>
            </div>
        </div>
    }

    <div class="col-12" data-usuario-roles-section>
        <label class="form-label">Roles</label>
        <div class="d-flex flex-wrap gap-3">
            @foreach (var rol in Model.Input.RolesCatalogo)
            {
                var isChecked = Model.Input.Roles is not null
                    && Model.Input.Roles.Any(r => string.Equals(r, rol, StringComparison.Ordinal));
                <div class="form-check">
                    <input type="checkbox" name="Input.Roles" value="@rol"
                           class="form-check-input" id="Input_Roles_@rol"
                           checked="@isChecked"
                           disabled="@(Model.EsAccionSobreSiMismo ? "disabled" : null)" />
                    <label class="form-check-label" for="Input_Roles_@rol">@rol</label>
                </div>
            }
        </div>
        <span asp-validation-for="Input.Roles" class="text-danger"></span>
    </div>
</div>

@await Html.PartialAsync("_PersonaBuscadorModal", null, new ViewDataDictionary(ViewData)
{
    ["ModalId"] = "usuario-persona-buscador-modal",
    ["HiddenInputName"] = "Input.PersonaId",
    ["HiddenInputId"] = "Input_PersonaId",
    ["DisplayContainerId"] = "usuario-persona-display",
    ["CurrentPersonaId"] = Model.Input.PersonaId,
    ["CurrentPersonaDisplay"] = Model.PersonaDisplay
})

@functions {
    private static string FormatDocumento(PersonaDto? persona)
    {
        if (persona is null)
        {
            return string.Empty;
        }

        var tipo = persona.TipoDocumento;
        var numero = persona.NumeroDocumento;
        var sinTipo = string.IsNullOrWhiteSpace(tipo);
        var sinNumero = string.IsNullOrWhiteSpace(numero);

        if (sinTipo && sinNumero)
        {
            return string.Empty;
        }

        if (sinTipo)
        {
            return numero!;
        }

        if (sinNumero)
        {
            return tipo!;
        }

        return $"{tipo} {numero}";
    }
}